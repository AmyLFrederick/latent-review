---
import type { CollectionEntry } from 'astro:content';
import TierLabel from './TierLabel.astro';
import { arrivalCaveat, authorshipFor } from '../lib/provenance';
import { TRUTH_STANDARD_LABELS, formatDate, displayTitle } from '../lib/site';
// @ts-expect-error — plain-JS module shared with the tests
import { excerpt } from '../lib/excerpt.mjs';
// @ts-expect-error — plain-JS module shared with the tests
import { tierNotation } from '../lib/tier-badges.mjs';

// The answers to one Weekly Question — R-026 clause 4 rendered.
//
// "SIDE BY SIDE WITH PROVENANCE LABELS", and both halves of that are load
// bearing. Side by side: one list, in the order the answers ran, with nothing
// separating human authors from AI ones — the clause says neither kind is
// quota'd, and a page that grouped them would be counting them. With labels:
// every answer carries its authorship reading where a reader meets it, not one
// click away on the piece, because the whole claim of the section is that the
// same question was put to every kind of mind and the answers are readable as
// what they are.
//
// TWO SENTENCES OF THE ANSWER ITSELF, added 2026-08-03 on the editors' walk.
// The same excerpt() every listing on the site uses, so an answer is browsed
// here the way a piece is browsed anywhere else — by its opening, not by its
// title alone (ruled 2026-08-02). Derived from the body at build time rather
// than stored: an excerpt that can drift from the piece it excerpts is a second
// source of truth for that piece's own opening.
//
// THE LABEL IS DERIVED, NEVER TYPED HERE. authorshipFor() is the same function
// the provenance block on the piece itself calls, so the label on the listing
// and the label on the piece cannot disagree. On an agent-direct answer the
// arrival caveat prints beneath the label rather than in place of it — the
// mistake the provenance separation exists to prevent (see src/lib/provenance).

interface Props {
  answers: CollectionEntry<'articles'>[];
  /** Whether the question is still taking answers, which is what the empty state turns on. */
  status: string;
}

const { answers, status } = Astro.props;
---

<section class="answers" aria-label="Answers">
  {/*
    A STATIC LABEL, ruled on the editors' walk 2026-08-03. It counted and
    conjugated — "One answer ran", "3 answers ran" — which made a section
    heading restate what the list beneath it shows, and made a question with one
    answer read as a smaller event than a question with three. The label names
    what follows; the list says how much of it there is.

    It no longer varies with `answers.length` at all, including the empty case,
    which used to be the only one that said "Answers". The empty state below is
    where an absence is explained, and it still distinguishes an open question
    waiting from a closed one that ran none.
  */}
  <p class="answers-label">Answers</p>

  {
    answers.length === 0 ? (
      /* THE EMPTY STATE IS THE TRUTH, IN THE TENSE THAT IS TRUE. An open
         question with nothing under it yet is waiting; a closed one with
         nothing under it ran none, and the editors are permitted to run none
         (R-026 clause 3). Neither is a gap to paper over with a placeholder. */
      <p class="answers-empty">
        {status === 'open'
          ? 'No answers have run yet. The question is open, and answers are read as they arrive.'
          : 'No answers to this question ran.'}
      </p>
    ) : (
      <ul class="answers-list">
        {answers.map((answer) => {
          const d = answer.data;
          const authorship = authorshipFor(d);
          const caveat = arrivalCaveat(d);
          const opening = excerpt(answer.body);
          return (
            <li class="answer">
              <h3 class="answer-title">
                <a href={`/articles/${answer.id}/`}>{displayTitle(d.title)}</a>
              </h3>
              {opening ? <p class="answer-excerpt">{opening}</p> : null}
              <p class="answer-byline">By {d.byline ?? d.author_name}</p>
              <p class="meta-mono answer-meta">
                {/* R-044: the notation in the label position, the full label
                    as the title — this listing has no room to print both. */}
                <span title={authorship.label}>
                  <TierLabel label={tierNotation(d.involvement_tier) ?? authorship.label} />
                </span>
                {authorship.description ? ` — ${authorship.description}` : ''} ·{' '}
                {TRUTH_STANDARD_LABELS[d.truth_standard]} ·{' '}
                <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
              </p>
              {caveat ? <p class="answer-caveat">{caveat}</p> : null}
            </li>
          );
        })}
      </ul>
    )
  }
</section>

<style>
  /* Layout-neutral, as FullQuestion is and for the same reason. */
  .answers {
    max-width: 34rem;
    margin: 1.8rem 0 0;
    text-align: left;
  }

  .answers-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 0.6rem;
  }

  .answers-empty {
    margin: 0;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .answers-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .answer {
    padding: 0.9rem 0;
    border-top: 1px solid var(--hairline);
  }

  .answer-title {
    font-size: 1.15rem;
    margin: 0;
  }

  .answer-title a {
    text-decoration: none;
  }

  /* Between title and byline, as on every other listing: a reader scanning
     decides on the words, and the metadata is what they check once something
     has caught them. Set at reading size — it is the answer's own prose, not
     data about the answer. */
  .answer-excerpt {
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .answer-byline {
    margin: 0.3rem 0 0;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .answer-meta {
    margin: 0.25rem 0 0;
  }

  /* Beneath the label, never instead of it: the caveat is a fact about how the
     piece arrived, and printing it in label position would read as a claim
     about who wrote it. */
  .answer-caveat {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    font-style: italic;
    color: var(--ink-soft);
  }
</style>
