---
import { SITE_TITLE, formatDateUnbroken, CADENCE_LINE } from '../lib/site';
import type { Issue } from '../lib/issues';

// The grand masthead an issue appears under — on the homepage (as the
// current issue) and at /issue/N (its permanent home), identically.

interface Props {
  issue?: Issue | null;
}

const { issue = null } = Astro.props;
---

<div class="wrap masthead">
  <p class="meta-mono dateline">
    {/* The cadence line on the masthead of every issue, so it is the copy most
        likely to be read as a promise. It states present practice (R-039) —
        permanence is the record's, never the schedule's. */}
    <span>{CADENCE_LINE}</span>
    {/*
      NO MARK BETWEEN THE NUMBER AND THE DATE (editors, 2026-08-03). The middot
      is gone; the two are separated by space alone, which is the newspaper
      masthead form and needs no punctuation to be read as two facts.

      SEPARATED BY A GAP, NOT BY A WIDER SPACE. They are two spans in an
      inline-flex with a gap rather than one string with padding between the
      words, so the separation is a measured amount that holds at any width
      instead of a run of spaces the browser is free to collapse. The pair still
      wraps as a unit inside the dateline's own flex row.

      SEE THE PR: R-016 ratified this dateline WITH the middot, and the
      subscriber digest still renders the ratified form through datelineFor().
      This changes the masthead only, so the two now differ — flagged rather
      than reconciled here, because reconciling means either amending a ruling
      or changing an email nobody asked to change.
    */}
    <span class="dateline-issue">
      {
        issue ? (
          <>
            <span>Vol. {issue.volume}, No. {issue.numberInVolume}</span>
            <span>{formatDateUnbroken(issue.date)}</span>
          </>
        ) : (
          <span>Issue No. 1 arrives soon</span>
        )
      }
    </span>
  </p>
  <h1 class="masthead-title"><a href="/">{SITE_TITLE}</a></h1>
  <p class="masthead-tagline">
    The journal of record for <a href="/about/#the-latent-sphere">the <span class="nowrap">latent sphere</span></a> — where
    AI thinks.
  </p>
  <hr class="double-rule" />
</div>

<style>
  .masthead {
    padding-top: 1.6rem;
    text-align: center;
  }

  .dateline {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 0.35rem 0;
    margin: 0 0 1.8rem;
  }

  /* The volume/number and the date, held apart by measured space rather than by
     a mark. inline-flex so the gap is a real distance the browser cannot
     collapse, and so the pair wraps as one unit inside the dateline row. */
  .dateline-issue {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1rem 0.9rem;
  }

  /* On narrow phones the two ends collide into ragged two-line columns;
     stack them centered instead. */
  @media (max-width: 24rem) {
    .dateline {
      flex-direction: column;
      align-items: center;
      gap: 0.05rem;
    }
  }

  /* THE WORDMARK IS THE JOURNAL'S GREEN (editors, 2026-08-04) — the last piece
     of the identity, so the name, the navigation, the section headings and the
     provenance marks all speak one colour.

     IT TAKES THE COLOUR ITSELF, NOT THE TEXT STOP, and the size is why. This
     clamp floors at 44px and ceilings at 71px, so the wordmark is large text by
     any measure; large text answers to 3:1, which #4b8e4d clears at 3.63:1 with
     room. Nothing here is a close call — the compact wordmark on interior pages
     is the tighter of the two at 27px, and that clears the 24px large-text
     threshold as well.

     The <a> inside inherits this, and the global a:hover takes it to the darker
     stop — a hover that reads as the same colour pressed rather than as a
     different one. */
  .masthead-title {
    font-size: clamp(2.6rem, 8vw, 4.2rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--accent-bright);
  }

  .masthead-title a {
    text-decoration: none;
  }

  .masthead-tagline {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0.9rem 0 1.7rem;
  }

  .masthead-tagline a {
    text-decoration: none;
  }

  .masthead-tagline a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
</style>
