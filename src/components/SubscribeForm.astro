---
// The subscription form — quiet and typographic. Posts to the subscribe
// Netlify Function; works without JavaScript (the function answers a bare
// form post with a rendered page) and inline when JavaScript is present.

import {
  SUBSCRIBE_DONE_HEADING,
  SUBSCRIBE_DONE_LEAD_BEFORE,
  SUBSCRIBE_DONE_LEAD_BOLD,
  SUBSCRIBE_DONE_LEAD_AFTER,
  SUBSCRIBE_DONE_SPAM,
} from '../lib/subscribe-copy.mjs';

interface Props {
  /** 'page' for the homepage, 'footer' for the site-wide footer. */
  variant?: 'page' | 'footer';
}

const { variant = 'page' } = Astro.props;
const inputId = `subscribe-email-${variant}`;

// WHICH DOOR THIS IS, FOR THE CONSENT RECORD. A subscription now begins the
// moment this form is submitted, so the row it writes has to say where the
// reader was standing. The server does not trust the value — it accepts these
// two strings and records anything else as `api` (see FORM_SOURCES in
// netlify/functions/subscribe.mts) — which is why a hidden field is honest
// here rather than a claim: it identifies our own two forms and cannot be used
// to write free text into the record.
const source = variant === 'footer' ? 'web-form-footer' : 'web-form';
---

<div class:list={['subscribe', { 'subscribe--footer': variant === 'footer' }]}>
  <form class="subscribe-form" method="post" action="/api/subscribe" data-source={source}>
    <input type="hidden" name="source" value={source} />
    <label class="sr-only" for={inputId}>Email address</label>
    <input
      id={inputId}
      type="email"
      name="email"
      required
      maxlength="254"
      placeholder="your@address"
      autocomplete="email"
    />
    <button type="submit">Subscribe</button>
  </form>
  {/*
    "Issue No. 1, delivered when it exists" was removed 2026-08-03: it was a
    pre-launch promise and Issue No. 1 has run, so it had been describing a
    state of the world that ended on 08-02. What remains is what the note is
    actually for — the terms a reader is agreeing to.

    "Confirmed opt-in" left the line on 2026-08-22 with the confirmation step it
    named. The other two promises are unchanged and are the ones a reader is
    actually weighing before typing an address: what we do with it, and how
    easily they can undo this.
  */}
  <p class="subscribe-note">
    No tracking, unsubscribe anytime.
  </p>
  <p class="subscribe-status" role="status" aria-live="polite"></p>
  {/*
    THE DONE PANEL IS RENDERED HERE AND HIDDEN, not built in JavaScript, so
    the sentences live in markup where they can be read, diffed and reviewed
    like every other line of the journal's copy. The words come from
    src/lib/subscribe-copy.mjs, which the Netlify function imports too — the
    no-JavaScript sheet at /api/subscribe says exactly this.

    IT REPLACES THE FORM RATHER THAN SITTING UNDER IT (editors, 2026-08-13).
    That was written when this panel carried an instruction and the worry was a
    success line under a live-looking form reading as "you're done". The reader
    IS done now, and the reasoning survives its own premise: a form still
    sitting there invites a second address into a field that has just accepted
    one, and the panel is the answer to the press, not a note beside it.
  */}
  <div class="subscribe-done" role="status" hidden>
    <p class="subscribe-done-heading">{SUBSCRIBE_DONE_HEADING}</p>
    <p class="subscribe-done-lead">
      {SUBSCRIBE_DONE_LEAD_BEFORE}<strong>{SUBSCRIBE_DONE_LEAD_BOLD}</strong>{
        SUBSCRIBE_DONE_LEAD_AFTER
      }
    </p>
    <p class="subscribe-done-spam">{SUBSCRIBE_DONE_SPAM}</p>
  </div>
</div>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.subscribe-form')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const block = form.parentElement;
      const status = block?.querySelector('.subscribe-status');
      const note = block?.querySelector<HTMLElement>('.subscribe-note');
      const done = block?.querySelector<HTMLElement>('.subscribe-done');
      const button = form.querySelector('button');
      const email = new FormData(form).get('email');
      const source = form.dataset.source ?? 'web-form';
      if (!status || !button || !done) return;
      button.disabled = true;
      status.classList.remove('subscribe-status--error');
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source }),
        });
        if (res.ok) {
          // The panel is the reply. The server's `message` is the same words
          // for any other client, but this one has them already, marked up.
          form.reset();
          form.hidden = true;
          if (note) note.hidden = true;
          status.textContent = '';
          done.hidden = false;
          return;
        }
        const data = await res.json().catch(() => null);
        status.textContent = data?.message ?? 'Something went wrong — please try again.';
        status.classList.add('subscribe-status--error');
      } catch {
        status.textContent = 'Something went wrong — please try again.';
        status.classList.add('subscribe-status--error');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .subscribe {
    max-width: 26rem;
    margin-inline: auto;
    text-align: center;
  }

  .subscribe-form {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.4rem;
  }

  .subscribe-form input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    padding: 0.2rem 0;
  }

  .subscribe-form input:focus {
    outline: none;
  }

  .subscribe-form input::placeholder {
    color: var(--ink-soft);
    opacity: 0.6;
    font-style: italic;
  }

  .subscribe-form button {
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0.2rem 0;
  }

  .subscribe-form button:hover,
  .subscribe-form button:focus-visible {
    color: var(--accent);
  }

  .subscribe-form button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .subscribe-note {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--ink-soft);
    margin: 0.8rem 0 0;
  }

  .subscribe-status {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    min-height: 1.2em;
    margin: 0.5rem 0 0;
  }

  /* Failure must be unmissable (editors' follow-up to PR #3): the accent,
     bordered, and set off from the quiet form — not a soft mono whisper.
     FLAGGED FOR THE WALK, 2026-08-03: that accent is now green, so a failure
     notice renders in the same colour as a section name. The instruction was
     the green everywhere the red served and this is one of those places, so it
     is done; whether an alarm should share the house colour is a question for
     the editors rather than for this file. */
  .subscribe-status--error {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.85rem;
    border: 1px solid var(--accent);
    background: rgba(62, 116, 63, 0.08);
    padding: 0.5rem 0.75rem;
    margin-top: 0.7rem;
  }

  /* HOUSE APPARATUS, NOT A TOAST. Rules above and below, centered, the
     journal's own faces — the same grammar the sheets at /api/confirm use and
     the same grammar an editors' note uses. Nothing here is a new visual
     language; it is the site's, at the size this block can carry. */
  .subscribe-done {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1.4rem 0.25rem 1.5rem;
    text-align: center;
  }

  .subscribe-done-heading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
    margin: 0;
  }

  .subscribe-done-lead {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink);
    margin: 0.9rem 0 0;
  }

  .subscribe-done-lead strong {
    font-weight: 600;
  }

  .subscribe-done-spam {
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0.7rem 0 0;
  }

  .subscribe--footer {
    max-width: 22rem;
  }

  /* The footer carries the same words at the footer's scale. The rules stay:
     they are what makes it apparatus rather than a stray paragraph in a
     column that already has several. */
  .subscribe--footer .subscribe-done {
    padding: 1.1rem 0 1.2rem;
  }

  .subscribe--footer .subscribe-done-heading {
    font-size: 1.15rem;
  }

  .subscribe--footer .subscribe-done-lead {
    font-size: 0.88rem;
  }

  .subscribe--footer .subscribe-done-spam {
    font-size: 0.8rem;
  }

  /* NO RULE UNDER THE FOOTER FIELD (editors' pass 2026-08-03). On the page the
     underline is the form's baseline and stays. In the footer it was the only
     horizontal rule in the block, landing mid-way down, where it read as a
     divider cutting the footer rather than as part of a field. The footer's
     rule now closes the footer instead — see .footer-close in Base.astro. */
  .subscribe--footer .subscribe-form {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .subscribe--footer .subscribe-note {
    font-size: 0.75rem;
  }
</style>
