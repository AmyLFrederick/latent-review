---
import { sectionUrl } from '../lib/site';
import type { Issue } from '../lib/issues';

// The body of an issue: the contents, and nothing else. Rendered identically on
// the homepage (current issue) and at /issue/N (the permanent record).
//
// THE LIST IS THE FRONT PAGE, ruled 2026-08-02. There was a large featured cover
// block above this; it is gone. A reader arriving mid-week wants to see
// everything that has run and reach any of it in one click, and a full-height
// feature spent the whole first screen saying what one line of the list already
// says. THE COVER'S PROMINENCE IS BEING FIRST.
//
// ONE LINE AND ONE META LINE PER PIECE — title, section, byline, each a link.
// The arrangement before that grouped section-headed cards at a card's height
// per piece, so an issue pushed its own later pieces off the screen as it filled
// out, which is backwards for a page that should get more useful as the week
// goes on.

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const { cover, sections } = issue;

// The issue's OWN order — cover first, then standing sections in their ruled
// order and floating sections after. Deliberately not `issue.articles`, which is
// newest-first: publication order is a fact about the day, and a contents page
// is a map of the issue rather than a timeline of it. As pieces merge through
// the day they appear in their section's place, not at the top.
const contents = [...(cover ? [cover] : []), ...sections.flatMap((group) => group.items)];

// THE ENTRIES ARE ALL ONE SIZE, ruled by the editors 2026-08-03. The cover
// entry was set a step larger than the rest; it is not any more, and the
// enlargement is gone rather than reduced.
//
// This is the second half of the 2026-08-02 ruling arriving. That one deleted a
// full-height feature block and said THE COVER'S PROMINENCE IS BEING FIRST —
// then kept a size step as a hedge against readers not perceiving position. The
// editors have now looked at it and taken the hedge away: being first is the
// prominence, and a list that means it does not also whisper it in type.
//
// The lead machinery went with the styling rather than being left dormant. It
// keyed off the cover EXISTING rather than off being first — an issue may have
// no Cover piece, and styling the first line as a lead would have told a reader
// an ordinary piece was the cover. That reasoning is recorded here because it is
// the trap anyone re-adding a lead style would fall into; it is no longer
// load-bearing, because nothing is styled as a lead.
---

<div class="wrap">
  {
    contents.length > 0 ? (
      <section class="issue-contents" aria-labelledby="in-this-issue">
        <h2 class="kicker issue-contents-title" id="in-this-issue">
          In this issue
        </h2>
        <ol class="contents-list">
          {contents.map((article) => (
            <li class="contents-item">
              <a class="contents-title" href={`/articles/${article.id}/`}>
                {article.data.title}
              </a>
              <p class="meta-mono contents-meta">
                <a href={sectionUrl(article.data.section)}>{article.data.section}</a> · By{' '}
                {article.data.author_name}
              </p>
            </li>
          ))}
        </ol>
      </section>
    ) : null
  }
</div>

<style>
  .issue-contents {
    padding-top: 1.8rem;
  }

  .issue-contents-title {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.45rem;
    margin-bottom: 0;
  }

  .contents-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contents-item {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .contents-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    line-height: 1.25;
    text-decoration: none;
    display: inline-block;
  }

  .contents-meta {
    margin: 0.3rem 0 0;
  }

  /* The lead rules that stood here are deleted, not commented out — the
     editors chose uniform on 2026-08-03, and a disabled style is an invitation
     to switch it back on without a ruling. Every entry is .contents-item and
     every title is one size. */
</style>
