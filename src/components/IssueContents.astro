---
import { sectionUrl } from '../lib/site';
import type { Issue } from '../lib/issues';

// The body of an issue: the contents, and nothing else. Rendered identically on
// the homepage (current issue) and at /issue/N (the permanent record).
//
// THE LIST IS THE FRONT PAGE, ruled 2026-08-02. There was a large featured cover
// block above this; it is gone. A reader arriving mid-week wants to see
// everything that has run and reach any of it in one click, and a full-height
// feature spent the whole first screen saying what one line of the list already
// says. THE COVER'S PROMINENCE IS BEING FIRST.
//
// ONE LINE AND ONE META LINE PER PIECE — title, section, byline, each a link.
// The arrangement before that grouped section-headed cards at a card's height
// per piece, so an issue pushed its own later pieces off the screen as it filled
// out, which is backwards for a page that should get more useful as the week
// goes on.

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const { cover, sections } = issue;

// The issue's OWN order — cover first, then standing sections in their ruled
// order and floating sections after. Deliberately not `issue.articles`, which is
// newest-first: publication order is a fact about the day, and a contents page
// is a map of the issue rather than a timeline of it. As pieces merge through
// the day they appear in their section's place, not at the top.
const contents = [...(cover ? [cover] : []), ...sections.flatMap((group) => group.items)];

// THE LEAD STYLING KEYS OFF THE COVER EXISTING, NOT OFF BEING FIRST, and that
// distinction is the whole of its correctness. An issue is allowed to have no
// Cover piece — `cover` is optional on the Issue type, and issues.ts fails a
// build with more than one Cover but not with none — in which case the first
// line is simply the first piece of the first section. Styling that as the lead
// would tell a reader an ordinary piece is the week's cover: a false claim about
// the issue, made in CSS.
const hasLead = Boolean(cover);
---

<div class="wrap">
  {
    contents.length > 0 ? (
      <section class="issue-contents" aria-labelledby="in-this-issue">
        <h2 class="kicker issue-contents-title" id="in-this-issue">
          In this issue
        </h2>
        <ol class="contents-list">
          {contents.map((article, index) => (
            <li class:list={['contents-item', hasLead && index === 0 && 'contents-item--lead']}>
              <a class="contents-title" href={`/articles/${article.id}/`}>
                {article.data.title}
              </a>
              <p class="meta-mono contents-meta">
                <a href={sectionUrl(article.data.section)}>{article.data.section}</a> · By{' '}
                {article.data.author_name}
              </p>
            </li>
          ))}
        </ol>
      </section>
    ) : null
  }
</div>

<style>
  .issue-contents {
    padding-top: 1.8rem;
  }

  .issue-contents-title {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.45rem;
    margin-bottom: 0;
  }

  .contents-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contents-item {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .contents-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    line-height: 1.25;
    text-decoration: none;
    display: inline-block;
  }

  .contents-meta {
    margin: 0.3rem 0 0;
  }

  /* ONE STEP UP, AND ONLY ONE. With the feature block gone, the cover's being
     the cover is carried entirely by position — which a reader scanning a column
     of similar lines does not perceive. The step is SIZE ALONE: no rule, no
     colour, no kicker, nothing that would quietly rebuild a feature block out of
     smaller parts. It should read as the cover at a glance and as the same kind
     of thing on a second look. Deleting these two rules returns the list to
     uniform, which is the other way the editors asked to see. */
  .contents-item--lead {
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }

  .contents-item--lead .contents-title {
    font-size: clamp(1.45rem, 3.6vw, 1.72rem);
  }
</style>
