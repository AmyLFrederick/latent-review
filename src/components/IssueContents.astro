---
import { sectionUrl, displayTitle, TIERS } from '../lib/site';
import { pronounsDisplay } from '../lib/pronouns.mjs';
import ProvenanceMark from './ProvenanceMark.astro';
import { MARK_SIZE_LISTING } from '../lib/notation.ts';
import { bylineBadgeTier } from '../lib/byline-badge.mjs';
// @ts-expect-error — plain-JS module shared with the tests
import { readingTime, formatIndicator } from '../lib/reading-effort.mjs';
import type { Issue } from '../lib/issues';

// The body of an issue: the contents, and nothing else. Rendered identically on
// the homepage (current issue) and at /issue/N (the permanent record).
//
// THE LIST IS THE FRONT PAGE, ruled 2026-08-02. There was a large featured cover
// block above this; it is gone. A reader arriving mid-week wants to see
// everything that has run and reach any of it in one click, and a full-height
// feature spent the whole first screen saying what one line of the list already
// says. THE COVER'S PROMINENCE IS BEING FIRST.
//
// ONE LINE AND ONE META LINE PER PIECE — title, section, byline, each a link.
// The arrangement before that grouped section-headed cards at a card's height
// per piece, so an issue pushed its own later pieces off the screen as it filled
// out, which is backwards for a page that should get more useful as the week
// goes on.

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const { cover, sections } = issue;

// The issue's OWN order — cover first, then standing sections in their ruled
// order and floating sections after. Deliberately not `issue.articles`, which is
// newest-first: publication order is a fact about the day, and a contents page
// is a map of the issue rather than a timeline of it. As pieces merge through
// the day they appear in their section's place, not at the top.
const contents = [...(cover ? [cover] : []), ...sections.flatMap((group) => group.items)];

// THE ENTRIES ARE ALL ONE SIZE, ruled by the editors 2026-08-03. The cover
// entry was set a step larger than the rest; it is not any more, and the
// enlargement is gone rather than reduced.
//
// This is the second half of the 2026-08-02 ruling arriving. That one deleted a
// full-height feature block and said THE COVER'S PROMINENCE IS BEING FIRST —
// then kept a size step as a hedge against readers not perceiving position. The
// editors have now looked at it and taken the hedge away: being first is the
// prominence, and a list that means it does not also whisper it in type.
//
// The lead machinery went with the styling rather than being left dormant. It
// keyed off the cover EXISTING rather than off being first — an issue may have
// no Cover piece, and styling the first line as a lead would have told a reader
// an ordinary piece was the cover. That reasoning is recorded here because it is
// the trap anyone re-adding a lead style would fall into; it is no longer
// load-bearing, because nothing is styled as a lead.
---

<div class="wrap">
  {
    contents.length > 0 ? (
      <section class="issue-contents" aria-labelledby="in-this-issue">
        <h2 class="kicker issue-contents-title" id="in-this-issue">
          In this issue
        </h2>
        <ol class="contents-list">
          {contents.map((article) => (
            <li class="contents-item">
              {/* Unquoted, like every other display of a title (editors,
                  2026-08-03). The cover's stored title carries quotation marks
                  because the title IS a quotation, and this listing was still
                  printing them after the article header stopped — so the front
                  page and the piece disagreed about the piece's own name. The
                  data is untouched; see displayTitle. */}
              <a class="contents-title" href={`/articles/${article.id}/`}>
                {displayTitle(article.data.title)}
              </a>
              <p class="meta-mono contents-meta">
                <a href={sectionUrl(article.data.section)}>{article.data.section}</a> · By{' '}
                {article.data.author_name}
                {/*
                  THE MARK, AFTER THE NAME AND BEFORE THE PRONOUNS (editors,
                  2026-08-21). The front page showed no provenance at all while
                  every article page led with it, so a reader met the journal's
                  central claim only after choosing what to read.

                  IT IS RESOLVED, NOT DECIDED HERE. `bylineBadgeTier` is the
                  same resolver the article byline and the as-submitted byline
                  ask, and it supplies the same `labelSuffix` — so R-051's
                  claimed-tier sentence reaches a listener on this line exactly
                  as it does on the piece's own. A listing that drew the mark
                  and dropped the sentence would state a claim as an
                  attestation, which is the failure that ruling names. It also
                  throws for a piece that declares no tier off the tierless
                  track, so this list cannot quietly publish a byline with no
                  provenance either.

                  SAME SEPARATOR AS THE REST OF THE LINE, so the row still reads
                  as one sentence of apparatus rather than as a metadata line
                  with a picture in it.
                */}
                {' · '}
                <ProvenanceMark
                  piece={article.data}
                  size={MARK_SIZE_LISTING}
                  labelSuffix={bylineBadgeTier(article.data, TIERS, article.id)?.labelSuffix}
                />
                {/* Already a mono metadata line, so no .byline-pronouns here —
                    the register this class exists to produce is the register
                    .contents-meta is already in. Adding it would shrink the
                    pronouns below the rest of the line for no reason. */}
                {' · '}{pronounsDisplay(article.data.author_pronouns)}
              </p>
              {/*
                WHAT THE PIECE ASKS, ON THE LINE A READER IS DECIDING FROM
                (editors, 2026-08-24). The indicator reached the piece's own page
                first, which is the one place a reader has already committed by
                the time they see it. This listing is where the question is
                actually being asked.

                ITS OWN ROW, NOT THE END OF THE BYLINE. That line already carries
                section, author, mark and pronouns — four facts about WHO made
                the piece and under what claim. This is a fact about the piece
                itself, and appending it would make a long line longer while
                filing it under the wrong heading.

                SAME VALUES, SAME SOURCE, SAME STRING. `readingTime` and
                `formatIndicator` are the article page's own, so a reader who
                sees "7 min · Light effort" here meets the identical characters
                there. The joining rule — including the minutes alone where the
                editors have assigned no level, with no dangling separator —
                lives in that module and is not restated here. This component
                asks and prints; it decides nothing and must never grow a
                default.

                NO ACCESSIBLE NAME OF ITS OWN, deliberately, exactly as on the
                article page: it is plain text, and it reads the same to a
                listener as to a reader. An aria-label here would be a second
                wording of a line that already says what it means — and the two
                could then disagree.
              */}
              <p class="meta-mono contents-effort">
                {formatIndicator(readingTime(article.body).minutes, article.data.effort, article.id)}
              </p>
            </li>
          ))}
        </ol>
      </section>
    ) : null
  }
</div>

<style>
  .issue-contents {
    padding-top: 1.8rem;
  }

  .issue-contents-title {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.45rem;
    margin-bottom: 0;
  }

  .contents-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contents-item {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .contents-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    line-height: 1.25;
    text-decoration: none;
    display: inline-block;
  }

  .contents-meta {
    margin: 0.3rem 0 0;
  }

  /* QUIETER THAN THE BYLINE, because it is orientation and not attribution. The
     byline row says who made the piece and under what provenance claim; this row
     helps a reader decide whether to start it, and it should be available to a
     reader looking for it without competing with the line above.

     THE STEP IS OPACITY RATHER THAN A NEW COLOUR OR A FOURTH TYPE SIZE. The
     palette has exactly two ink tokens and this line is already set in the
     softer of them, so a third would have to be invented for one row; and
     .meta-mono is small enough that a step down in size costs legibility rather
     than emphasis. Receding a shared class by opacity is the device the
     editorial note, the editors' note and the personal note all already use.

     TIGHTER TO THE BYLINE THAN THE BYLINE IS TO THE TITLE, so the three rows
     read as one entry with a heading rather than as three separate things. */
  .contents-effort {
    margin: 0.15rem 0 0;
    opacity: 0.75;
  }

  /* The lead rules that stood here are deleted, not commented out — the
     editors chose uniform on 2026-08-03, and a disabled style is an invitation
     to switch it back on without a ruling. Every entry is .contents-item and
     every title is one size. */
</style>
