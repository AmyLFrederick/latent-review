---
import { formatDate } from '../lib/site';
// @ts-expect-error — plain-JS module shared with the tests
import { questionBlocks } from '../lib/prompts.mjs';

// The question as posed — the canonical text, one click from the headline.
//
// WHY THIS IS A DISCLOSURE AND NOT A CUT. Ruled 2026-08-03: /prompts leads each
// question with its short form and puts the full text behind a marked link, so
// a reader meets the question the way it is asked aloud and the answers sit
// directly under it rather than below a screen of framing. What is behind the
// link is the whole thing — headline, premise, framing, and the verification
// record — verbatim, exactly as R-026 clause 1 makes it canonical. This is a
// display choice about ORDER OF READING, and the text it hides is the text the
// authors answered, which is why the summary says so rather than promising
// "more detail".
//
// NOTHING HERE EDITS A QUESTION. The blocks come from the questions file
// unaltered. A question is never SILENTLY edited (R-038, superseding R-026
// clause 5 in part): a correction is allowed and carries a dated record saying
// what changed, which is a different thing from a page quietly showing some of
// the words and not others. This component does the second thing never.

interface Props {
  /** A posed question, as readQuestions() returns it. */
  question: {
    text: string;
    sources?: string[];
    opened?: string | null;
    closed?: string | null;
    status?: string;
  };
  /**
   * Whether to print the question's dateline inside the disclosure.
   *
   * DEFAULTS TO TRUE, so a surface that renders the question as posed gets the
   * complete record without having to know to ask for it. The archive is the
   * one caller that opts out, because it prints the same dateline on the entry
   * two lines above this. A duplicate is visible and mildly untidy; an omission
   * is invisible, which is why the default errs toward printing.
   */
  showDates?: boolean;
}

const { question, showDates = true } = Astro.props;

// The same split /prompts and the archive lead with, from the one module that
// owns it — a second implementation here could divide the canonical text
// differently from the surface that shows the headline.
const blocks = questionBlocks(question.text);

const sources = Array.isArray(question.sources) ? question.sources : [];

// THE DATELINE, restored here on the editors' walk of 2026-08-03 after the
// section page stopped printing it above the question. This is where a reader
// checks when a question was asked and whether it is still taking answers, so
// the canonical view of the question carries it and is self-contained.
//
// IT COSTS NO HEIGHT ON THE PAGE. This is a <details>, collapsed until a reader
// opens it, which is the whole reason the line could come back after being
// removed for pushing the answers down.
//
// Madison local days, like every date the record names (CLAUDE.md). A bare
// YYYY-MM-DD is read back as UTC midnight, which returns the day it was written
// as — the parse is not what decides the day, the editor is.
//
// Guarded on `opened` rather than on status: an unasked question has no opening
// date and nothing true to say here, and a caller that hands one over should
// get silence rather than "Asked null".
const asDay = (iso: string) => formatDate(new Date(`${iso}T00:00:00Z`));
const dateline =
  showDates && question.opened
    ? question.closed
      ? `Asked ${asDay(question.opened)} · closed ${asDay(question.closed)}`
      : `Asked ${asDay(question.opened)} · ${question.status ?? 'open'}`
    : null;
---

<details class="full-question">
  <summary>Read the full question as posed</summary>
  <div class="full-question-body">
    {dateline ? <p class="full-question-dateline">{dateline}</p> : null}
    <p class="full-question-note">
      This is the question in full, verbatim as it was posed, and it is what every author
      answered — the line above is its first sentence, not a summary of it. A question is never
      silently edited: a correction to one is dated, shown, and keeps the original readable.
    </p>
    {blocks.map((block) => <p class="full-question-block">{block}</p>)}
    {
      /* THE VERIFICATION RECORD, ON THE PAGE FOR THE FIRST TIME. The checking
         happens before a question is posed, and what was checked is recorded in
         the questions file — R-026 clause 5 made that unavoidable, and R-038
         keeps it by making a correction a visible, versioning event rather than
         an impossible one. A
         record kept where readers cannot read it asks them to take the checking
         on trust, which is the opposite of what it is for. An empty list is
         honest — a question may assert nothing — and prints nothing. */
      sources.length > 0 ? (
        <>
          <p class="full-question-sources-label">Checked before posing</p>
          <ul class="full-question-sources">
            {sources.map((source) => (
              <li>{source}</li>
            ))}
          </ul>
        </>
      ) : null
    }
  </div>
</details>

<style>
  /* Layout-neutral on purpose: the centred question block wraps this in its
     own column, and the archive lists it left-aligned in place. A component
     that centred itself would sit off-axis in one of the two. */
  .full-question {
    max-width: 34rem;
    margin: 1.2rem 0 0;
    text-align: left;
  }

  /* A link, and it has to look like one: this is the reader's route to the
     canonical text, and a disclosure triangle alone reads as decoration. */
  .full-question summary {
    cursor: pointer;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--ink-soft);
  }

  .full-question[open] summary {
    margin-bottom: 0.9rem;
  }

  .full-question-body {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Set like the apparatus it is, and first inside the disclosure — a reader
     opening this is checking the record, and when it was asked and whether it
     is open are the two questions they most often came with. */
  .full-question-dateline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 0.8rem;
  }

  .full-question-note {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .full-question-block {
    margin: 0 0 0.9rem;
  }

  .full-question-sources-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 1.2rem 0 0.4rem;
  }

  .full-question-sources {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .full-question-sources li {
    margin: 0 0 0.35rem;
  }
</style>
