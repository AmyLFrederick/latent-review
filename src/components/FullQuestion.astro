---
// The question as posed — the canonical text, one click from the headline.
//
// WHY THIS IS A DISCLOSURE AND NOT A CUT. Ruled 2026-08-03: /prompts leads each
// question with its short form and puts the full text behind a marked link, so
// a reader meets the question the way it is asked aloud and the answers sit
// directly under it rather than below a screen of framing. What is behind the
// link is the whole thing — headline, premise, framing, and the verification
// record — verbatim, exactly as R-026 clause 1 makes it canonical. This is a
// display choice about ORDER OF READING, and the text it hides is the text the
// authors answered, which is why the summary says so rather than promising
// "more detail".
//
// NOTHING HERE EDITS A QUESTION. The blocks come from the questions file
// unaltered; a question is never edited once posed (R-026 clause 5), and that
// includes the kind of editing that consists of only showing some of it.

interface Props {
  /** A posed question, as readQuestions() returns it. */
  question: { text: string; sources?: string[] };
}

const { question } = Astro.props;

const blocks = String(question.text)
  .split(/\n\s*\n/)
  .map((block) => block.trim())
  .filter(Boolean);

const sources = Array.isArray(question.sources) ? question.sources : [];
---

<details class="full-question">
  <summary>Read the full question as posed</summary>
  <div class="full-question-body">
    <p class="full-question-note">
      This is the question in full, verbatim as it was posed, and it is what every author
      answered — the line above is its first sentence, not a summary of it. A question is never
      edited once posed.
    </p>
    {blocks.map((block) => <p class="full-question-block">{block}</p>)}
    {
      /* THE VERIFICATION RECORD, ON THE PAGE FOR THE FIRST TIME. R-026 clause 5
         makes a posed question uncorrectable, so the checking happens before it
         is posed and what was checked is recorded in the questions file. A
         record kept where readers cannot read it asks them to take the checking
         on trust, which is the opposite of what it is for. An empty list is
         honest — a question may assert nothing — and prints nothing. */
      sources.length > 0 ? (
        <>
          <p class="full-question-sources-label">Checked before posing</p>
          <ul class="full-question-sources">
            {sources.map((source) => (
              <li>{source}</li>
            ))}
          </ul>
        </>
      ) : null
    }
  </div>
</details>

<style>
  /* Layout-neutral on purpose: the centred question block wraps this in its
     own column, and the archive lists it left-aligned in place. A component
     that centred itself would sit off-axis in one of the two. */
  .full-question {
    max-width: 34rem;
    margin: 1.2rem 0 0;
    text-align: left;
  }

  /* A link, and it has to look like one: this is the reader's route to the
     canonical text, and a disclosure triangle alone reads as decoration. */
  .full-question summary {
    cursor: pointer;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--ink-soft);
  }

  .full-question[open] summary {
    margin-bottom: 0.9rem;
  }

  .full-question-body {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .full-question-note {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .full-question-block {
    margin: 0 0 0.9rem;
  }

  .full-question-sources-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 1.2rem 0 0.4rem;
  }

  .full-question-sources {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .full-question-sources li {
    margin: 0 0 0.35rem;
  }
</style>
