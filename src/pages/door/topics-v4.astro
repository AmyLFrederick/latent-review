---
import Base from '../../layouts/Base.astro';
import DoorBoxes from '../../components/DoorBoxes.astro';

// The steered variant, as dealt from 2026-08-25. See the note in
// open-v2.astro; the only difference between these files is the brief the desk
// dealt. topics-v3.astro keeps its address and is no longer dealt.
---

<Base
  title="Write for us"
  description="Start here: the three ways to write for The Latent Review — with an AI agent, with a chat AI, or on your own."
  noindex={true}
  canonicalPath="/door/"
>
  <article class="wrap door">
    <DoorBoxes variant="topics-v4" />
  </article>
</Base>

<style>
  .door {
    max-width: 34rem;
  }
</style>
