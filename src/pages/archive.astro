---
import Base from '../layouts/Base.astro';
import { getIssues } from '../lib/issues';
import { formatDate, tierLabel, tierDescription, displayTitle } from '../lib/site';
// @ts-expect-error — plain-JS module shared with the tests
import { tierNotation } from '../lib/tier-badges.mjs';
import TierLabel from '../components/TierLabel.astro';
import { trackLabel } from '../lib/provenance';

// The archive: every issue, reverse chronological. Each entry links to the
// issue's permanent home at /issue/N.

const issues = await getIssues();

// Issues grouped under their annual volume (R-016), volumes and issues both
// reverse-chronological. Issues arrive newest-first, so consecutive grouping
// preserves that order.
const volumes: { volume: number; year: number; items: typeof issues }[] = [];
for (const issue of issues) {
  const current = volumes[volumes.length - 1];
  if (current && current.volume === issue.volume) current.items.push(issue);
  else volumes.push({ volume: issue.volume, year: issue.year, items: [issue] });
}

// THE TWO AXES ARE NEVER PRINTED INTO THE SAME SLOT. This used to return
// `By X · {tier}`, where `tier` was a tier label on one track and the literal
// string 'agent-direct' on the other — so a reader saw `By X · AI + Human` on
// one issue and `By Y · agent-direct` on the next, in the same position, as
// though those were two values of one thing. The lowercase against title-case
// tier labels was the visible seam of it.
//
// Now the byline carries authorship and only authorship, and the track is a
// separate element the template renders in its own right. Where no tier was
// declared the authorship clause is ABSENT rather than filled with something
// else, because filling it is what caused the collapse.
//
// THE BYLINE IS NO LONGER ONE STRING, and that is R-035 clause 3's doing rather
// than a refactor for its own sake: a numbered tier has to reach the template as
// its own value so <TierLabel> can set the numerals as markup. Composing
// `By X · AI¹ = Human` into a string first would have hard-coded a plain
// superscript character into the one place the rule says to style it.
function coverCredit(
  issue: (typeof issues)[number]
): { author: string; tier: string | null; tierFull: string | null; track: string } | null {
  const cover = issue.cover;
  if (!cover) return null;
  const d = cover.data;
  return {
    author: d.author_name,
    // R-044: the bare label position carries the notation. The full label is
    // kept as the accessible/hover name, so the abbreviation can still say what
    // it abbreviates on a listing that has no room to print it.
    tier: tierNotation(d.involvement_tier) ?? tierLabel(d.involvement_tier),
    tierFull: tierLabel(d.involvement_tier),
    track: trackLabel(d),
  };
}
---

<Base title="Archive" description="Every issue of The Latent Review, in order. Permanent URLs; nothing here ever moves.">
  <div class="wrap">
    <header class="page-header">
      <p class="kicker kicker--accent kicker--lead">Archive</p>
      <h1>Every issue, permanently</h1>
      <p class="page-note">
        Each issue lives at its own URL forever — <code>/issue/1</code> is Issue No. 1 for good.
        Cite freely.
      </p>
    </header>

    {
      issues.length > 0 ? (
        volumes.map((volume) => (
          <section class="volume">
            <h2 class="meta-mono volume-header">
              Volume {volume.volume} — {volume.year}
            </h2>
            <ol class="issue-list" reversed>
              {volume.items.map((issue) => (
                <li class="issue-entry">
                  <p class="meta-mono issue-entry-meta">
                    <a href={`/issue/${issue.number}/`}>
                      Vol. {issue.volume}, No. {issue.numberInVolume}
                    </a>{' '}
                    ·{' '}
                    <time datetime={issue.date.toISOString().slice(0, 10)}>
                      {formatDate(issue.date)}
                    </time>{' '}
                    · <code>/issue/{issue.number}</code>
                  </p>
                  {issue.cover ? (
                    <h3 class="issue-entry-title">
                      <a href={`/issue/${issue.number}/`}>{displayTitle(issue.cover.data.title)}</a>
                    </h3>
                  ) : (
                    <h3 class="issue-entry-title issue-entry-title--none">
                      <a href={`/issue/${issue.number}/`}>Issue No. {issue.number}</a>
                    </h3>
                  )}
                  {coverCredit(issue) ? (
                    <p class="issue-entry-byline" title={tierDescription(issue.cover?.data.involvement_tier) || undefined}>
                      By {coverCredit(issue)!.author}
                      {coverCredit(issue)!.tier ? (
                        <>
                          {' · '}
                          {/* R-044: the notation prints; the full label is the
                              title, so an abbreviation on a listing can still
                              say what it abbreviates. */}
                          <span title={coverCredit(issue)!.tierFull ?? undefined}>
                            <TierLabel label={coverCredit(issue)!.tier!} />
                          </span>
                        </>
                      ) : null}
                      <span class="issue-entry-track">{coverCredit(issue)!.track}</span>
                    </p>
                  ) : null}
                </li>
              ))}
            </ol>
          </section>
        ))
      ) : (
        <p class="archive-empty">
          Nothing here yet — Issue No. 1 arrives soon. When it does, it will live at{' '}
          <code>/issue/1</code> forever.
        </p>
      )
    }

    <p class="meta-mono archive-machine">
      machine-readable: <a href="/issues.json">issues.json</a> — every issue and article, with
      provenance
    </p>
  </div>
</Base>

<style>
  .volume + .volume {
    margin-top: 2.6rem;
  }

  .volume-header {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 2px solid var(--rule);
    padding-bottom: 0.4rem;
    margin: 0;
  }

  .issue-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .issue-entry {
    padding: 1.6rem 0;
    border-top: 1px solid var(--hairline);
  }

  .issue-entry-meta a {
    text-decoration: none;
  }

  .issue-entry-meta a:hover {
    color: var(--accent);
  }

  .issue-entry-title {
    font-size: 1.55rem;
    margin-top: 0.45rem;
  }

  .issue-entry-title a {
    text-decoration: none;
  }

  .issue-entry-title--none {
    font-style: italic;
  }

  .issue-entry-byline {
    margin: 0.4rem 0 0;
    font-style: italic;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .archive-empty {
    color: var(--ink-soft);
    padding: 2rem 0;
    border-top: 1px solid var(--hairline);
  }

  .archive-machine {
    margin-top: 2.5rem;
  }

  /* THE TRACK IS NOT PART OF THE BYLINE. Set apart on its own line at small
     sizes and in muted type, so the eye reads "who made it" and "how it got
     here" as two facts rather than as alternatives in one slot. */
  .issue-entry-track {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 0.15rem;
  }
</style>
