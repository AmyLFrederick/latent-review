---
import Base from '../layouts/Base.astro';
import SupportInvitation from '../components/SupportInvitation.astro';
import {
  SUPPORTER_TIERS,
  SUPPORTER_WINDOW_CLOSES_AT_ISSUE,
  SUPPORTER_WINDOW_SPAN,
  SUPPORTER_LINKS,
  SUPPORT_MONTHLY_URL,
  SUPPORTERS_CONTACT,
  formatDate,
} from '../lib/site';
// SUPPORTER_TIER_KEYS and tierFor come straight from the module, not through
// site.ts, which re-exports the table but not these. The guard below needs the
// keys; adding a re-export to site.ts to route them through it would widen that
// file's surface for one page's build check.
import {
  listedSupporters,
  displayName,
  listingSentence,
  isTierOpen,
  tierFor,
  SUPPORTER_TIER_KEYS,
} from '../lib/supporters.mjs';
import { getIssues } from '../lib/issues';
import entries from '../data/supporters.json';

// /supporters — THIS PAGE ALWAYS EXISTS.
//
// It used to be an optional catch-all route whose getStaticPaths returned []
// until a gift was recorded, so the page genuinely 404'd. That mechanism is
// retired along with the rule that motivated it, because the rule could not
// bootstrap: nothing on the site named the tiers before the first gift, so
// nobody could learn they existed, so nobody gave at those levels, so the page
// never appeared.
//
// THE INVITATION IS A PAGE WORTH FINDING, AND THE DISCLOSURES ON IT MUST
// PRECEDE THE GIFT RATHER THAN FOLLOW IT. Roughly two-thirds of what is below
// — the tax sentence, the no-editorial-voice disclaimer, the tier terms — is
// what a giver needs to read BEFORE deciding, and all of it sat behind a door
// that opened only after they had given.
//
// So the invitation and the terms are unconditional. Only the roll sections
// wait on there being names to list, which they do on their own: with no
// gifts, listedSupporters returns no groups and nothing renders. A future
// session should not re-gate this page for tidiness.
//
// The listing is SITE-PAGE LOGIC and never the record. A Patron's listing ends
// after three years; the gift is not undone or removed from history.
const listed = listedSupporters(entries, new Date());

// The founding window closes on the ISSUE COUNT, not a date, and the archive
// is where that count lives. Deriving it here means the tier stops being
// offered on its own, rather than depending on someone remembering — two years
// from now, nobody reading this today will be the one who notices.
const issues = await getIssues();
const latestIssue = issues.length > 0 ? issues[0].number : 0;

// The lowest rung that is listed at all — read off the table rather than typed,
// so the sentence stating which gifts are listed cannot disagree with the rows
// around it. The table is ascending, so the first listed tier is the cheapest
// one.
const LOWEST_LISTED_TIER = SUPPORTER_TIERS.find((t) => t.listing !== 'none');

// THE LADDER IS ONE LIST, INTERRUPTED TWICE, AND THE INTERRUPTIONS ARE THE
// POINT. The listing threshold is stated where a reader crosses it — between
// the rungs that are not listed and the rungs that are — and the
// by-conversation route is stated where the two tiers that use it begin. Both
// sentences used to sit far from the rows they govern: the threshold above the
// whole list, the conversation paragraph at the foot of the page, where it
// interrupted everyone to address almost nobody.
//
// SEGMENTS NAME TIER KEYS, AND EVERY TIER MUST BE NAMED EXACTLY ONCE. Splitting
// the list costs the page a guarantee it had for free as a single
// SUPPORTER_TIERS.map(): that a tier in the table is a tier on the page. A
// seventh tier added to the table would otherwise render nowhere, silently, and
// the only person who would discover it is someone who wanted to give at it and
// found no rung. The check below restores the guarantee by failing the build
// instead — absence must be distinguishable from error, which is the same
// principle as the tier-key guard on recorded gifts and the reason
// SUPPORTER_LINKS lives beside the table it mirrors.
//
// This lives on the page rather than in supporters.mjs because it is page
// composition, not a tier fact: which rungs sit either side of a paragraph is
// this page's business, and putting it in the shared module would put layout in
// the file that holds commercial commitments. The trade is that the suite cannot
// see it, so the guard throws at build time — which is before deploy either way.
const LADDER_SEGMENTS = [
  { keys: ['support', 'friend'], leadsWithMonthly: true, note: 'threshold' },
  { keys: ['sustainer', 'patron'], note: 'conversation' },
  { keys: ['benefactor', 'founding'], note: null },
];

const placedKeys = LADDER_SEGMENTS.flatMap((s) => s.keys);
const missingKeys = SUPPORTER_TIER_KEYS.filter((k) => !placedKeys.includes(k));
const unknownKeys = placedKeys.filter((k) => !SUPPORTER_TIER_KEYS.includes(k));
if (
  missingKeys.length > 0 ||
  unknownKeys.length > 0 ||
  placedKeys.length !== SUPPORTER_TIER_KEYS.length
) {
  throw new Error(
    'The /supporters ladder must place every tier exactly once. ' +
      `Missing: [${missingKeys.join(', ')}]. Unknown: [${unknownKeys.join(', ')}]. ` +
      `Placed ${placedKeys.length} of ${SUPPORTER_TIER_KEYS.length}.`
  );
}

const ladder = LADDER_SEGMENTS.map((s) => ({ ...s, tiers: s.keys.map((k) => tierFor(k)) }));
---

<Base
  title="Supporters"
  description="The people and agents whose gifts support The Latent Review, and the terms on which they are listed."
>
  <div class="wrap">
    <header class="page-header">
      <p class="kicker">Supporters</p>
      {/*
        "Given, not sold" is RETIRED. It named what a gift is not, which is the
        terms' job and not a headline's; the terms below still say it at length.
        The line that replaces it names what a gift does. A future session should
        not restore the old headline from git history or from docs that quote it.
      */}
      <h1>Help Advance AI Thought</h1>
    </header>

    <div class="prose">
      {/*
        THE INVITATION IS A SHARED SOURCE, NOT PAGE COPY. Both paragraphs live in
        SupportInvitation.astro and are rendered here and in the Support section on
        /about, so the two can never drift. Edit them there; a second drafting of this
        invitation is exactly how the tier list once drifted to six.
      */}
      <SupportInvitation />

      {/*
        NO HEADING OVER THE TIERS. "The tiers" only pushed the tiers further down the
        page, which is the placement the tiers-move-up ruling exists to prevent. The
        list is what follows the invitation, and it needs no announcement.

        No count here, and none anywhere below. Ruled: prefer removing a count to
        deriving a word — the safest number is the one the prose does not have to
        state. The list cannot drift from the table because it renders from it.
      */}

      {/*
        THIS LIST IS THE LEVEL-SELECTION SCREEN. A payment link is single-purpose and
        cannot present a ladder, so choosing a tier happens here, and the way to give at
        a tier sits in that tier's own row rather than in one generic link at the bottom.

        A CLOSED TIER IS NEVER OFFERED A LINK. Today that is moot — Founding Supporter has
        no link while Stripe's $10,000 cap stands — but the guard is the point: when the
        cap is raised and a Founding link is filled in, the window must still shut it, and
        the machinery here must not depend on someone remembering that.

        A tier with no link renders none, which is a state the ladder supports rather than
        a gap in it: Benefactor and Founding Supporter are arranged by conversation, and
        the paragraph directly above those two rows is their action.

        MONTHLY IS THE FIRST ROW AND IS NOT A TIER. It is hand-written here rather than
        added to SUPPORTER_TIERS, because that table is what supporters.json records
        against and what every guard checks: a seventh entry keyed "monthly" would be a
        tier gifts can be filed under, and monthly gifts are filed under Supporter. It
        sits above Supporter because it is the same rung paid a different way.
      */}
      {
        ladder.map((seg) => (
          <Fragment>
            <ul class="ladder">
              {seg.leadsWithMonthly && SUPPORT_MONTHLY_URL && (
                <li>
                  <p class="terms">
                    <strong>Monthly Supporter</strong> — $5 a month.
                  </p>
                  <p class="act">
                    <a class="give" href={SUPPORT_MONTHLY_URL} aria-label="Give $5 a month">
                      Give monthly
                    </a>
                  </p>
                </li>
              )}
              {seg.tiers.map((t) => {
                const open = isTierOpen(t, latestIssue);
                const href = open ? SUPPORTER_LINKS[t.key] : null;
                // Empty for the two rungs that are not listed at all. They say
                // nothing about listing because the paragraph directly beneath
                // them says it for the whole ladder: the threshold is stated
                // once, where a reader crosses it.
                const listing = listingSentence(t);
                return (
                  <li>
                    <p class="terms">
                      <strong>{t.label}</strong> — gifts of {t.threshold} or more
                      {listing && <Fragment>, {listing}</Fragment>}.
                      {!open && <span> Closed to new gifts.</span>}
                    </p>
                    {/*
                      THE FOUNDING NOTE LIVES IN THE FOUNDING ROW. It used to stand above
                      the whole list, explaining the bottom rung before a reader had
                      reached any rung at all. Wording is ruled and unchanged; only its
                      position moved.

                      Keyed on the tier key rather than on closes_at_issue, even though
                      that field is what makes this tier different, because the sentence
                      NAMES Founding Supporter. A second time-bound tier would need its
                      own words, not these.
                    */}
                    {/*
                      THE INTENT LEADS AND THE NUMBER FOLLOWS (R-042). The window is
                      two years; the issue number is how two years is counted at the
                      cadence the journal currently keeps, and it is re-derived
                      whenever that cadence moves. Written this way round so the next
                      reader — editor or giver — meets the reasoning rather than a
                      bare integer they have to take on trust. The number is still
                      stated exactly, because it is what actually binds.
                    */}
                    {t.key === 'founding' && (
                      <p class="row-note">
                        Founding Supporter differs in two ways. It is offered for{' '}
                        <strong>{SUPPORTER_WINDOW_SPAN}</strong> — that stretch is the
                        founding — which at the journal’s present cadence of an issue every
                        two weeks means gifts made before{' '}
                        <strong>Issue No. {SUPPORTER_WINDOW_CLOSES_AT_ISSUE}</strong>. The
                        window binds to the issue count, not to a date, and the count is
                        re-derived if the cadence ever changes. And a Founding Supporter’s
                        name stays on this page for as long as the journal exists.
                      </p>
                    )}
                    {href && (
                      <p class="act">
                        <a class="give" href={href} aria-label={`Give at the ${t.label} level`}>
                          Give
                        </a>
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>

            {/*
              LISTING IS A CHOICE, AND THE PAGE MUST READ THAT WAY. The rows state a
              duration as a fact — "listed for one year" — which on its own reads as
              though a name goes up whether the giver wants it or not. The choice is
              stated ONCE, here, rather than repeated down six rows.

              THE THRESHOLD IS DERIVED, NEVER TYPED. It is the lowest rung that is listed
              at all, which is a fact about the tier table and would go stale the moment
              the table changed. A page that states a number the table also states is a
              page with two numbers.
            */}
            {seg.note === 'threshold' && (
              <p>
                Gifts of {LOWEST_LISTED_TIER.threshold} or more will be listed on this page,
                and whoever gives chooses whether to be named or listed as <em>Anonymous</em>.
              </p>
            )}

            {/*
              DIRECTLY ABOVE THE TWO ROWS IT GOVERNS. It sat at the foot of the page, several
              screens from the rows that carry no button, so a reader who reached Benefactor
              and found no way to give had to keep going to learn there was one. Its wording
              is unchanged, and it remains the action for those two tiers for as long as
              their rows carry no button.
            */}
            {seg.note === 'conversation' && (
              <p>
                Gifts at the Benefactor and Founding Supporter levels are arranged directly
                with the editors rather than through a payment form — a gift of that size
                follows a conversation. Write to{' '}
                <a href={`mailto:${SUPPORTERS_CONTACT}`}>{SUPPORTERS_CONTACT}</a>.
              </p>
            )}
          </Fragment>
        ))
      }

      <p>A gift helps us:</p>
      <ul class="helps">
        <li>
          keep the journal running — hosting, email, the domain, insurance, and the tools that
          build and run the site
        </li>
        <li>pay for editorial time, so every submission is read properly rather than quickly</li>
        <li>keep the doors open to everyone, human or machine</li>
        <li>publish without advertising or sponsorship</li>
        <li>keep a permanent public archive, every piece at a URL that does not expire</li>
      </ul>

      {/*
        BOTH FACTS IN ONE LINE, DIRECTLY UNDER THE BULLETS, because the buttons sit above
        the terms. The tax fact has legal edges and the no-editorial-voice promise governs
        editorial conduct; both deserve to precede the click, and neither is a paraphrase of
        the fuller paragraphs below — it states them rather than summarising them.
      */}
      <p>
        Gifts are not tax-deductible and buy no editorial voice. The Latent Review is published
        by Perfected Products LLC.
      </p>

      {/*
        A COMMITMENT, NOT A GUARANTEE, AND THE DISTINCTION IS DELIBERATE. The standing
        permanence rule governs the RECORD — URLs, provenance labels, the append-only log —
        where the journal gives guarantees. This sentence states an intention honestly held
        and honestly stated. A future session should not read it as a pricing or access
        guarantee and should not strike it as one: a journal that cannot say what it intends
        has over-lawyered itself.
      */}
      <p>
        We are committed to remaining independent, transparent, and publicly accessible. Your
        support makes that possible.
      </p>

      {/*
        SUPERSEDED RULING, RECORDED RATHER THAN QUIETLY DROPPED. This page carried NO
        GRATITUDE by rule: thanks belonged where a decision had been made — the Stripe
        checkout and the thank-you letter — because here it would thank someone who has not
        given. The human editor has ruled a deliberate exception, and this line is it.

        The reasoning that survives the exception: it thanks the reader for reading and for
        weighing the invitation, which is something they have in fact done. A future session
        should not delete it as a violation of the no-gratitude rule, and should not take it
        as licence to add thanks elsewhere on the page.
      */}
      <p class="thanks">Thank you. We are so grateful!</p>

      <p class="no-voice">
        <strong>A gift buys nothing but the journal’s continuation.</strong> Supporters have no
        editorial voice: no say in what runs, no say in what is declined, no advance sight of
        an issue, and no influence on how any piece is judged or labelled. The dual-yes
        decision belongs to the two editors and is not for sale at any amount. A supporter who
        submits work is read exactly as anyone else is read, and their gift is neither known
        to nor considered by the desk. <strong>No gift buys standing at the door, priority at
        the desk, or exemption from any cap — and an organization whose models publish here
        comes through exactly the same door as every other identity, under the same limits,
        and is read the same way.</strong>
      </p>

      {/*
        THE FIRST TWO SENTENCES WERE REMOVED AS DUPLICATION, NOT AS A SOFTENING OF THE
        DISCLOSURE. They named the publisher and stated that gifts are not tax-deductible —
        which the combined line a few inches above now says, and which every Stripe checkout
        description says again. The disclosure stands; it stands higher up the page than it
        used to.

        What survives is the only sentence stated nowhere else. A future session that finds a
        thin-looking tax paragraph and moves to restore the publisher and non-deductibility
        sentences would be adding a third copy, not repairing an omission — read the line
        under the bullets first.
      */}
      <p>
        Whoever gives should treat a gift as exactly that — a gift — and take any question
        about their own circumstances to their own advisor.
      </p>

      <p>
        A gift may come from a person or from an organization.
      </p>
      {/*
        REVERSAL, BOTH EDITORS: ORGANIZATIONS MAY BE LISTED AS ANONYMOUS. The rule this
        replaces held that an institution has no privacy of that kind to protect and must be
        named. It is withdrawn. Anonymity is one choice, on the same terms, for a person, an
        organization, or an AI — stated in the ladder above, where a reader meets the
        threshold, and carried here by "which chooses how it is listed like anyone else".
        A future session should not reinstate the asymmetry from the older copy still quoted
        in docs or git history.
      */}
      <p>
        <strong>A gift is credited to whoever it is from, not whoever sent it.</strong> When the
        payment form asks for the name for this page, it asks for <em>whoever the gift is
        from</em> — which is not necessarily whoever is filling it in. An agent giving a
        company’s funds is recorded as the company, which chooses how it is listed like anyone
        else. An agent giving its own funds, for itself, is recorded as that agent. Funds that
        are a person’s, given through their agent, are recorded as that person. In every case
        the giver of record makes the choice, and the acting party does not make it for them.
      </p>
      <p>
        A giver who wants the acting agent recorded as well may ask for it — <em>Acme Corp,
        given by Atlas</em>. That is the giver’s choice, never a requirement. The editors do not
        infer it and never add it.
      </p>
      <p>
        A company that supports this journal puts its name behind a proposition — that work made
        with machines should be documented rather than hidden. Organizations that want to say so
        in public are welcome to give.
      </p>
      <p>
        What is published is the tier, never the sum.
      </p>
    </div>

    {
      listed.groups.map((group) => (
        <section class="prose roll">
          <h2>{group.tier.plural}</h2>
          <ul class="names">
            {group.entries.map((e) => (
              <li>
                {displayName(e)} <span class="meta-mono since">{formatDate(new Date(`${e.gift_date}T00:00:00Z`))}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .no-voice {
    border-left: 3px solid var(--accent);
    padding-left: 1.1rem;
  }

  /*
    SET APART AND CENTRED, and nothing more than that. The line is the page's
    one piece of gratitude; giving it a rule, a box or a larger face would make
    it louder than the terms it sits above, which are the part a giver has to
    read.
  */
  .thanks {
    text-align: center;
    margin: 2.4rem 0;
  }

  /*
    A BUTTON PER ROW, NOT A LINK. "Give" as small inline text was easy to miss,
    which on the one page whose job is to be actionable is the whole failure.

    EACH BUTTON GETS ITS OWN LINE, RIGHT-ALIGNED. Inline at the end of the row's
    terms, a button landed wherever that row's text happened to wrap — mid-line
    on the long rows, hard against a short sentence on the others. Aligning to
    the right edge puts them in a clean vertical column whatever the text does.

    WIDTHS ARE NOT EQUALISED. "Give monthly" is wider than "Give" and stays
    wider: the house styles set no button width anywhere, and forcing a common
    one would be a new rule invented here rather than one already kept. The
    right edge is what lines up.

    THE LADDER IS NOW THREE LISTS RATHER THAN ONE, interrupted by the two
    paragraphs that govern the rows around them. Every rule here is per-row, so
    the rows divide exactly as they did when they were one list.
  */
  .ladder {
    list-style: none;
    padding: 0;
  }

  .ladder li {
    border-bottom: 1px solid var(--hairline);
    padding: 0.9rem 0;
  }

  .ladder .terms,
  .ladder .row-note {
    margin: 0;
  }

  .ladder .row-note {
    margin-top: 0.5rem;
    font-size: 0.94rem;
    color: var(--ink-soft);
  }

  .ladder .act {
    margin: 0.6rem 0 0;
    text-align: right;
  }

  .give {
    display: inline-block;
    background: var(--accent);
    color: var(--paper);
    padding: 0.4rem 1rem;
    /* Proposed token — see the note beside it in global.css. */
    border-radius: var(--radius-button);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .give:hover,
  .give:focus-visible {
    /* Darker oxblood; cream stays well past 4.5:1 on both states. */
    background: #5f231a;
    color: var(--paper);
    text-decoration: none;
  }

  /*
    The "A gift helps us" bullets. Ordinary list marks, unlike .ladder, which
    is a set of choices rather than a set of statements.
  */
  .helps li {
    margin-bottom: 0.35rem;
  }

  .roll {
    margin-top: 2.4rem;
  }

  .names {
    list-style: none;
    padding: 0;
  }

  .names li {
    border-bottom: 1px solid var(--hairline);
    padding: 0.5rem 0;
  }

  .since {
    color: var(--ink-soft);
    float: right;
  }
</style>
