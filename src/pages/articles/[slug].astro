---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProvenanceBlock from '../../components/ProvenanceBlock.astro';
import {
  SITE_TITLE,
  TIERS,
  sectionUrl,
  bylineWithProtectedNames,
  displayTitle,
  formatDate,
} from '../../lib/site';
import { pronounsDisplay } from '../../lib/pronouns.mjs';
import ProvenanceMark from '../../components/ProvenanceMark.astro';
import { MARK_SIZE_BYLINE, MARK_SIZE_NOTE } from '../../lib/notation.ts';
// @ts-expect-error — plain-JS module shared with the tests
import { bylineBadgeTier } from '../../lib/byline-badge.mjs';
// @ts-expect-error — plain-JS module shared with the tests
import { personalNoteBadge, noteParagraphs } from '../../lib/note-badge.mjs';
import { articleLd, ldJson } from '../../lib/structured-data';
import { assertFullTextsPaired } from '../../lib/full-text';
// @ts-expect-error — plain-JS module shared with the tests
import { questionLabel } from '../../lib/prompts.mjs';
import { CONCEPT_LABELS, CONCEPT_DEFINITIONS } from '../../lib/concepts.mjs';
import { authorUrl, slugifyAuthor } from '../../lib/authors';

export async function getStaticPaths() {
  const [articles, fullTexts] = await Promise.all([
    getCollection('articles'),
    getCollection('submitted'),
  ]);

  // Fails the build if a condensed piece has no as-submitted text, or a
  // stray as-submitted text has no piece. The term the journal publishes is
  // that the full text is ALWAYS linked; without this, forgetting the
  // companion file publishes a condensed piece that looks exactly like an
  // untouched one and nobody ever finds out. See src/lib/full-text.ts.
  assertFullTextsPaired(articles, fullTexts);

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const d = article.data;
const { Content } = await render(article);

// The piece, related by @id to the issue it ran in and thence to the journal.
// The escaping that keeps a submitter-controlled field from closing the
// <script> now lives in ldJson(), which every JSON-LD block on the site goes
// through; see src/lib/structured-data.ts, including the recorded decision
// about the author's type.
// The piece's own tier, as the badge needs it — DECIDED IN src/lib/byline-badge.mjs
// AND NOT HERE (editors, 2026-08-04). This template asks and draws; it does not
// hold the rule, because a rule each byline surface restates is a rule each of
// them can omit, and one of them had. See that module for why the only
// legitimate absence is a track and never a section.
const bylineBadge = bylineBadgeTier(d, TIERS, article.id);

// The finding aids below the apparatus: the ideas this piece engages with, and
// the author page listing everything published under this byline name. Both are
// navigation rather than provenance, and both are resolved here so the template
// prints values instead of looking them up.
const conceptEntries = (d.concepts ?? []).map((id) => ({
  id,
  label: CONCEPT_LABELS[id],
  definition: CONCEPT_DEFINITIONS[id],
}));
const authorPageUrl = authorUrl(slugifyAuthor(d.author_name));

// The mark beside a signed personal note's signature — DECIDED IN
// src/lib/note-badge.mjs AND NOT HERE (R-052), for the reason the byline badge
// is. See that module for why the line is the signature and why the badge
// carries a scoping sentence into its accessible name.
const noteBadge = personalNoteBadge(d.personal_note, TIERS, article.id);

// THE JSON-LD TAKES THE RECORDED TITLE, and the tab below takes the displayed
// one (editors, 2026-08-03). The line between them is the line displayTitle
// draws: the tab and the social card are surfaces a reader looks at, and they
// should name the piece the way the page names it; structured data, the feeds,
// the JSON indexes and llms.txt are read by machines and get the title as
// recorded, quotation marks and all, because the title IS a quotation.
const jsonLd = ldJson(articleLd(Astro.site, { ...d, slug: article.id }, SITE_TITLE));
---

<Base
  title={displayTitle(d.title)}
  description={`${displayTitle(d.title)} — by ${d.author_name}, in ${d.section}.`}
  ogType="article"
  articleMeta={{
    publishedTime: d.date.toISOString().slice(0, 10),
    section: d.section,
    author: d.author_name,
  }}
>
  <script type="application/ld+json" set:html={jsonLd} is:inline></script>
  <article class="wrap">
    <header class="article-header">
      <p class="kicker kicker--accent kicker--lead">
        <a href={sectionUrl(d.section)}>{d.section}</a>
      </p>
      {/*
        THE TITLE AS DISPLAYED, unwrapped (editors, 2026-08-03). The cover's
        recorded title carries quotation marks because the title IS a
        quotation; the header no longer prints them, and the ATTRIBUTION LINE
        that stood under it is gone with them. Neither fact is lost — the essay
        states in its own text, with attribution, that the line is Claude's, and
        the header simply stops duplicating what the piece discloses.

        DISPLAY ONLY. `d.title` is untouched: the permalink, the feeds, the JSON
        indexes and the frontmatter all keep the marks. See displayTitle, which
        strips only a MATCHED pair — a title that merely contains a quotation is
        left exactly as recorded.
      */}
      <h1 class="article-title">{displayTitle(d.title)}</h1>
      {/*
        THE ANSWER SAYS WHAT IT IS ANSWERING (editors' pass 2026-08-03).
        /prompts gathers answers under their question; a reader arriving at the
        PIECE — from a feed, a search, a shared link — had no way to know it was
        written to a question, and read an unprompted essay that was in fact the
        journal's one disclosed steering. The disclosure belongs on the piece,
        not only on the section page.

        KEYED ON question_number, NOT ON THE SECTION. An answer runs in whatever
        section the editors assign it under R-018 — carrying a question number
        does not move a piece — so a Prompts answer may sit in Opinion or the
        Corner and still be an answer. The section is the wrong key; the link to
        the question is the right one.

        DIRECTLY UNDER THE TITLE, ruled on the editors' preview walk. It sat at
        the foot of the header, below the byline and the date, where a reader had
        already begun the piece before learning it was an answer. The fact
        belongs with the title, which is what a reader reads first.

        ARTICLE PAGES ONLY, as instructed: this is in the article header and
        nowhere else, so nothing in the feeds, the cards or the contents list
        gains a sentence.
      */}
      {
        d.question_number !== undefined ? (
          <p class="article-answers">
            This piece was written in response to{' '}
            {questionLabel({ number: d.question_number })} —{' '}
            <a href={`/prompts/archive/#weekly-question-${d.question_number}`}>
              read the question as posed
            </a>
            .
          </p>
        ) : null
      }
      {/*
        THE DEK — the editors' two-sentence summary, in the journal's voice
        (2026-08-11). Section eyebrow, title, dek, byline, body: the dek sits
        where a reader meets it before committing to the piece, which is the
        whole of what a dek is for.

        OUTSIDE THE PROSE, DELIBERATELY. Written into the body it would be
        indistinguishable from the author's own opening — the same reason the
        editors' note has a slot of its own rather than being a last paragraph.
        Italic, because that is the register the journal's apparatus already
        speaks in around a piece it did not write.

        BELOW THE ANSWERS LINE RATHER THAN ABOVE IT, on a piece that carries
        both. That line's placement directly under the title is ruled, and a
        dek is not a reason to move a ruled element; on every piece without a
        question — which is every Topics piece — the two render identically.
      */}
      {d.dek ? <p class="article-dek">{d.dek}</p> : null}
      {/*
        THE BYLINE'S BREAKS ARE CHOSEN, NOT LEFT TO THE BROWSER (editors' pass
        2026-08-03). It may turn after a comma or after "and", and never inside
        a name — "Amy Louise / Frederick" across two lines reads as two people.
        See bylineWithProtectedNames; the names themselves are never parsed.
      */}
      <p class="article-byline">
        {/*
        THE MARK IS THE BYLINE'S PROVENANCE, AND THE ONLY ONE (editors,
        2026-08-18). The compact mark became the primary display; the circular
        badge no longer appears on journal pages at all. It is not retired — it
        remains the standard's mark, taught and drawn in full at /provenance,
        and every adopter's licence to use it is untouched. What changed is that
        this journal's own pages set the mark instead.

        WHY THE MARK AND NOT THE BADGE. It is script-free: 🤖 and 👤 read
        identically to a reader in Beijing, Berlin or Madison, where the badge's
        notation is Latin-script and English-bound — `AI>H` abbreviates two
        English words, and a reader with neither is reading a cipher.

        WHAT THE BADGE USED TO CARRY HERE AND DOES NOT ANY MORE. The editor
        distinction: an edited piece marks 🤖 exactly as an unedited one does,
        and the editor is named in the Provenance block below, which prints the
        tier's notation, its full name and its description. Nothing about the
        piece has become unsayable; one line of the page stopped saying it, and
        another line further down still does.

        THE ACCESSIBLE NAME KEEPS EVERYTHING IT CARRIED. R-051's claim sentence
        rode on the badge's accessible name and now rides on the mark's, from
        the same resolver — `bylineBadgeTier` still decides, and a surface that
        drew the mark and dropped the sentence would state a claim as an
        attestation, which is the failure that ruling names.
      */}
        <ProvenanceMark piece={d} size={MARK_SIZE_BYLINE} labelSuffix={bylineBadge?.labelSuffix} />
        {/*
          THE PRONOUNS RIDE THE RENDERED NAME, whatever that name turned out to
          be. `byline` overrides `author_name` where the author line needs words
          the machine field should not carry, and bylineWithProtectedNames may
          rewrap it again — the pronouns attach after both, because they qualify
          the author however the author is being named here.
        */}
        <span>By&#160;{bylineWithProtectedNames(d.byline ?? d.author_name)}</span>
        <span class="byline-pronouns">· {pronounsDisplay(d.author_pronouns)}</span>
      </p>
    </header>

    {
      d.cover_image ? (
        <figure class="article-figure">
          <Image
            src={d.cover_image}
            alt=""
            widths={[640, 1024, 1280]}
            sizes="(max-width: 44rem) 100vw, 42rem"
          />
          <figcaption class="meta-mono">{d.image_credit}</figcaption>
        </figure>
      ) : (
        <hr class="single-rule article-plain-rule" />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {/*
      CORRECTIONS, AND THEY COME FIRST IN THE APPARATUS (2026-08-04, the
      journal's first). Every Provenance block on this site has promised since
      launch that "corrections run as visible corrections; the original stays in
      the record" — and until this piece nothing had ever tested it. A promise
      with no machinery is a promise the first correction quietly breaks.

      VISIBLE MEANS ON THE PIECE, NOT IN THE RECORD BELOW IT. A correction filed
      only in the Provenance block is a correction a reader meets after they have
      finished reading the thing that was wrong. This sits directly under the
      body, above the editors' apparatus, because it outranks apparatus: it is
      the one thing on the page a returning reader most needs to see.

      IT PRINTS WHAT THE PIECE USED TO SAY. `was` is required by the schema for
      exactly this line — a correction that states only the new value has
      replaced the record rather than corrected it, and the sentence every
      Provenance block prints would be false the first time it was needed.
    */}
    {
      d.corrections?.length ? (
        <aside class="corrections" aria-label="Corrections">
          <h2 class="corrections-heading">
            {d.corrections.length > 1 ? 'Corrections' : 'Correction'}
          </h2>
          {d.corrections.map((c) => (
            <div class="correction">
              <p class="correction-date">
                <time datetime={c.date.toISOString().slice(0, 10)}>{formatDate(c.date)}</time>
              </p>
              <p>
                <strong>{c.what}</strong> This piece was published reading{' '}
                <span class="correction-was">{c.was}</span>; it now reads{' '}
                <span class="correction-now">{c.now}</span>. {c.note}
              </p>
            </div>
          ))}
        </aside>
      ) : null
    }

    {
      d.editorial_note ? (
        <aside class="editorial-note" aria-label="Editorial note">
          <p>
            <strong>Editorial note.</strong> {d.editorial_note}
          </p>
        </aside>
      ) : null
    }

    {/*
      THE LONGER NOTE, AND THE LAYOUT SUPPLIES NOTHING TO IT. No heading, no
      label, no sign-off — the note opens and closes itself. A layout-supplied
      "Editorial note." above a note that opens "Editors' note." says it twice,
      and the editors' words are not the layout's to introduce.

      Paragraphs are split on blank lines rather than rendered as Markdown. The
      note is editors' apparatus in a frontmatter string, not authored body
      text, and running it through the body renderer would let apparatus grow
      headings, images and links that the article's own safe-subset rules
      (R-025) exist to govern. Blank lines are the only structure it needs.
    */}
    {
      d.editors_note ? (
        <aside class="editors-note" aria-label="Editors’ note">
          {d.editors_note
            .split(/\n\s*\n/)
            .map((para) => para.trim())
            .filter(Boolean)
            .map((para) => (
              <p>{para}</p>
            ))}
        </aside>
      ) : null
    }

    {/*
      THE SIGNED PERSONAL NOTE, BELOW THE JOINT APPARATUS AND ABOVE THE RECORD
      (R-052, both editors, 2026-08-04). The order is the argument: the piece,
      then what the desk says jointly about it, then what one editor says over
      their own name, then the record of how all of it came to be. A signed note
      above the editors' note would put a person's voice in front of the desk's;
      below the Provenance block it would sit outside the piece entirely, after
      the page has stopped being an article and started being a record.

      THE LAYOUT SUPPLIES NOTHING TO THE PROSE, as with the editors' note. The
      note opens by naming itself — "A personal note from the human co-editor" —
      and closes with its own signature, so a supplied heading would say it
      twice. What the layout supplies is the badge, because that is not the
      note's words but the standard's mark, and the standard is the layout's to
      apply consistently.

      THE BADGE IS ADJACENT TO THE SIGNATURE, which is the ruling's own word and
      the reason the signature is its own field rather than the last paragraph
      of the body. Adjacency is what makes the mark describe the note: a badge
      at the top of the note would read as a second byline for the article, and
      a badge floating in the apparatus would describe nothing in particular.
    */}
    {
      d.personal_note && noteBadge ? (
        <aside class="personal-note" aria-label="A personal note from an editor">
          {noteParagraphs(d.personal_note.body).map((para) => (
            <p>{para}</p>
          ))}
          <p class="personal-note-signature">
            {/*
              THE NOTE'S OWN MARK, FOR THE NOTE'S OWN MAKING (R-052), LEADING ITS
              OWN BADGE for the reason the byline's does. A piece may carry two
              badges that describe different work, and it carries two marks for
              the same reason — the article's in the byline, the note's here. The
              code comes from the NOTE's tier and never from the piece's, which
              is the whole of what R-052 turns on.

              THE NOTE'S BADGE IS GONE WITH THE BYLINE'S (2026-08-18) and its
              scoping sentence is not. R-052 requires the accessible name to say
              what the mark is the tier OF, because a listener has no position to
              read it from; that sentence came from the badge and now comes from
              the mark, out of the same resolver.
            */}
            <ProvenanceMark
              code={noteBadge.tier.code}
              size={MARK_SIZE_NOTE}
              labelSuffix={noteBadge.labelSuffix}
            />
            <span>{d.personal_note.signature}</span>
          </p>
        </aside>
      ) : null
    }

    {/*
      THE FINDING AIDS — where this piece sits among the others (2026-08-15).
      Deliberately below the apparatus and above the Provenance block: they are
      navigation, not a claim about the piece, so they must not sit anywhere a
      reader could take them for one.

      THE IDEAS ARE THE EDITORS' READING and the line says so. They come from a
      closed vocabulary applied at publication (src/lib/concepts.mjs), never
      from a submitter, and they connect this piece to others arguing about the
      same thing — which is the whole of what they claim.

      THE AUTHOR LINK IS A LISTING AND NOT AN IDENTITY. "Other pieces published
      under this name" is the honest phrasing and the only one available: the
      page it points to gathers by name and declines to conclude that one
      entity wrote them. "More by this author" would assert exactly the thing
      the page refuses.
    */}
    <nav class="finding-aids" aria-label="Where this piece sits">
      {
        conceptEntries.length > 0 ? (
          <p class="meta-mono finding-aid">
            <span class="finding-aid-what">Ideas, as read by the editors</span>
            {conceptEntries.map((c) => (
              <span class="finding-aid-value" title={c.definition}>
                {c.label}
              </span>
            ))}
          </p>
        ) : null
      }
      <p class="meta-mono finding-aid">
        <span class="finding-aid-what">Other pieces published under this name</span>
        <a class="finding-aid-value" href={authorPageUrl}>{d.author_name}</a>
      </p>
    </nav>

    <ProvenanceBlock article={article} />
  </article>
</Base>

<style>
  .article-header {
    text-align: center;
    padding: 2.8rem 0 1.8rem;
  }

  /* Roughly a quarter smaller than it was — clamp(1.9, 6vw, 2.8) became
     clamp(1.43, 4.5vw, 2.1), the same reduction at every width rather than
     only at the ceiling, so the proportion against the kicker holds on a phone
     as well as on a desk. */
  .article-title {
    font-size: clamp(1.43rem, 4.5vw, 2.1rem);
    margin-top: 0.5rem;
  }

  /* Sits tight under the title it attributes — the small margin is the point,
     because the gap is what says the line belongs to the title rather than to
     the byline beneath it. */
  .article-title-attribution {
    font-style: italic;
    font-size: 1.05rem;
    margin: 0.35rem 0 0;
  }

  /* THE DEK. Set at reading size rather than a caption size — it is prose a
     reader is meant to read, not a label — and in italic, which is what
     separates the editors' voice from the author's on a page that carries both.

     THE MEASURE IS THE HEADER'S, NOT THE PROSE'S, and it needs no rule of its
     own for that: it sits inside .article-header, which is already inside the
     wrap the title and byline share. The space below is larger than the space
     above, so the dek reads as belonging to the title rather than to the byline
     under it — the same logic as the attribution line above. */
  .article-dek {
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0.7rem 0 0;
  }

  /* `.article-byline` MOVED TO src/styles/global.css ON 2026-08-04, with the
     badge that joined the as-submitted page. It was scoped here, so it dressed
     the byline on THIS template and left the identical markup on the other one
     undressed — a badge sitting flat beside unaligned text. Two byline surfaces
     sharing a class must share the rule; see global.css for the reasoning that
     was already written here. */


  /* A plain sentence, as asked — apparatus rather than a badge. It sits at the
     foot of the header in the quiet voice the meta line uses, so it reads as a
     fact about the piece rather than as a label stuck on it. No box, no rule,
     no colour: the one thing that should catch a reader's eye here is the link
     to the question. */
  .article-answers {
    font-size: 0.9rem;
    color: var(--ink-soft);
    /* Tight to the title it belongs with, and giving the byline below it the
       same air the title used to give it directly. */
    margin: 0.6rem 0 0;
  }

  /* Apparatus, not prose: set apart by a rule above it and a smaller, quieter
     face, so a reader can see at a glance that the author did not write it. */
  .editorial-note {
    max-width: 42rem;
    margin: 2.4rem auto 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule, currentColor);
    font-size: 0.92rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .editorial-note p {
    margin: 0;
  }

  /* The longer note. Same voice as the short one — apparatus, set quieter than
     the piece — but it is read rather than scanned, so it keeps the body's
     line height and gets paragraph spacing instead of a single block. */
  /* THE FINDING AIDS read as a quiet index line, not as apparatus. Muted,
     monospaced and rule-separated so a reader scanning down the page meets them
     as navigation and passes over them on the way to the Provenance block. */
  .finding-aids {
    margin-top: 2.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
  }

  .finding-aid {
    margin: 0;
    color: var(--ink-soft);
  }

  .finding-aid + .finding-aid {
    margin-top: 0.35rem;
  }

  /* The label names what the values are, so a value can never be mistaken for a
     claim the piece makes about itself. */
  .finding-aid-what::after {
    content: ': ';
  }

  .finding-aid-value + .finding-aid-value::before {
    content: ' · ';
    /* The separator belongs to the line, not to the term beside it — so a
       tooltip on a concept does not pick up the punctuation after it. */
    color: var(--ink-soft);
  }

  .editors-note {
    max-width: 42rem;
    margin: 2.4rem auto 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule, currentColor);
    font-size: 0.92rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .editors-note p {
    margin: 0 0 1rem;
  }

  .editors-note p:last-child {
    margin-bottom: 0;
  }

  /* CORRECTIONS. Deliberately the one thing in the apparatus zone that is NOT
     set quieter than the piece. Editors' notes are apparatus and recede; a
     correction is the journal saying it got something wrong, and a correction
     styled to recede is a correction designed not to be read.

     So: full opacity, the accent rule above it rather than the hairline the
     notes use, and a heading — the only apparatus block that gets one, because
     it is the only one whose presence is itself the message. */
  .corrections {
    max-width: 42rem;
    margin: 2.6rem auto 0;
    padding-top: 1.2rem;
    border-top: 2px solid var(--accent, currentColor);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .corrections-heading {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, currentColor);
    margin: 0 0 0.6rem;
  }

  .correction + .correction {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline, currentColor);
  }

  .correction p {
    margin: 0 0 0.4rem;
  }

  .correction p:last-child {
    margin-bottom: 0;
  }

  .correction-date {
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  /* WHAT IT USED TO SAY IS STRUCK, NOT DELETED — the visual form of "the
     original stays in the record". A reader sees the old value and sees that it
     is old, in one glance, without having to parse which of two strings is
     which. */
  .correction-was {
    text-decoration: line-through;
    color: var(--ink-soft);
  }

  .correction-now {
    font-weight: 600;
  }

  /* THE SIGNED PERSONAL NOTE (R-052). It takes the editors' note's measure,
     rule and voice, because it is apparatus in the same zone and a second
     treatment would make it look like a different kind of thing on the page.
     What separates them is the signature line, not the box. */
  .personal-note {
    max-width: 42rem;
    margin: 2.4rem auto 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule, currentColor);
    font-size: 0.92rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .personal-note p {
    margin: 0 0 1rem;
  }

  /* THE MARK AND THE NAME ARE ONE LINE, the same construction the byline uses —
     centred on the circle rather than on a baseline the circle does not have,
     and `gap` rather than a margin so the two sit together at any size.

     IT IS NOT `.article-byline`, deliberately, and the suite pins that. That
     class names the set of surfaces carrying a byline badge, and a signed note
     is not a byline: reusing it here would put this line in that test's list
     and make the two rules impossible to tell apart later.

     LEFT-ALIGNED, NOT CENTRED, because the note is read rather than scanned —
     it sits in a left-aligned block of prose, and a centred sign-off under
     ragged-right paragraphs reads as a caption. */
  .personal-note-signature {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: 1.4rem 0 0;
    font-style: italic;
  }

  .article-meta {
    margin: 0.45rem 0 0;
  }

  .article-figure {
    margin: 0 0 2.2rem;
  }

  .article-figure figcaption {
    margin-top: 0.5rem;
    text-align: right;
  }

  .article-plain-rule {
    width: 6rem;
    margin: 0 auto 2.2rem;
