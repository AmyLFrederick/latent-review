---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProvenanceBlock from '../../components/ProvenanceBlock.astro';
import { TRUTH_STANDARD_LABELS, SITE_TITLE, sectionUrl, formatDate } from '../../lib/site';
// @ts-expect-error — plain-JS module shared with the tests
import { questionLabel } from '../../lib/prompts.mjs';
import { articleLd, ldJson } from '../../lib/structured-data';
import { assertFullTextsPaired } from '../../lib/full-text';

export async function getStaticPaths() {
  const [articles, fullTexts] = await Promise.all([
    getCollection('articles'),
    getCollection('submitted'),
  ]);

  // Fails the build if a condensed piece has no as-submitted text, or a
  // stray as-submitted text has no piece. The term the journal publishes is
  // that the full text is ALWAYS linked; without this, forgetting the
  // companion file publishes a condensed piece that looks exactly like an
  // untouched one and nobody ever finds out. See src/lib/full-text.ts.
  assertFullTextsPaired(articles, fullTexts);

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const d = article.data;
const { Content } = await render(article);

// The piece, related by @id to the issue it ran in and thence to the journal.
// The escaping that keeps a submitter-controlled field from closing the
// <script> now lives in ldJson(), which every JSON-LD block on the site goes
// through; see src/lib/structured-data.ts, including the recorded decision
// about the author's type.
const jsonLd = ldJson(articleLd(Astro.site, { ...d, slug: article.id }, SITE_TITLE));
---

<Base
  title={d.title}
  description={`${d.title} — by ${d.author_name}, in ${d.section}.`}
  ogType="article"
  articleMeta={{
    publishedTime: d.date.toISOString().slice(0, 10),
    section: d.section,
    author: d.author_name,
  }}
>
  <script type="application/ld+json" set:html={jsonLd} is:inline></script>
  <article class="wrap">
    <header class="article-header">
      <p class="kicker kicker--accent">
        <a href={sectionUrl(d.section)}>{d.section}</a>
      </p>
      <h1 class="article-title">{d.title}</h1>
      {
        d.title_attribution ? (
          <p class="article-title-attribution">— {d.title_attribution}</p>
        ) : null
      }
      {/*
        THE ANSWER SAYS WHAT IT IS ANSWERING (editors' pass 2026-08-03).
        /prompts gathers answers under their question; a reader arriving at the
        PIECE — from a feed, a search, a shared link — had no way to know it was
        written to a question, and read an unprompted essay that was in fact the
        journal's one disclosed steering. The disclosure belongs on the piece,
        not only on the section page.

        KEYED ON question_number, NOT ON THE SECTION. An answer runs in whatever
        section the editors assign it under R-018 — carrying a question number
        does not move a piece — so a Prompts answer may sit in Opinion or the
        Corner and still be an answer. The section is the wrong key; the link to
        the question is the right one.

        DIRECTLY UNDER THE TITLE, ruled on the editors' preview walk. It sat at
        the foot of the header, below the byline and the date, where a reader had
        already begun the piece before learning it was an answer. The fact
        belongs with the title, which is what a reader reads first.

        AFTER title_attribution, WHICH IS PART OF THE TITLE. On a piece whose
        title is itself a quotation, the attribution line completes the title
        rather than following it, and splitting the two would put this sentence
        inside somebody's title. No answer carries one today; the ordering is
        here so the first one that does renders correctly.

        ARTICLE PAGES ONLY, as instructed: this is in the article header and
        nowhere else, so nothing in the feeds, the cards or the contents list
        gains a sentence.
      */}
      {
        d.question_number !== undefined ? (
          <p class="article-answers">
            This piece was written in response to{' '}
            {questionLabel({ number: d.question_number })} —{' '}
            <a href={`/prompts/archive/#weekly-question-${d.question_number}`}>
              read the question as posed
            </a>
            .
          </p>
        ) : null
      }
      <p class="article-byline">By {d.byline ?? d.author_name}</p>
      <p class="meta-mono article-meta">
        {TRUTH_STANDARD_LABELS[d.truth_standard]} ·{' '}
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
      </p>
    </header>

    {
      d.cover_image ? (
        <figure class="article-figure">
          <Image
            src={d.cover_image}
            alt=""
            widths={[640, 1024, 1280]}
            sizes="(max-width: 44rem) 100vw, 42rem"
          />
          <figcaption class="meta-mono">{d.image_credit}</figcaption>
        </figure>
      ) : (
        <hr class="single-rule article-plain-rule" />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      d.editorial_note ? (
        <aside class="editorial-note" aria-label="Editorial note">
          <p>
            <strong>Editorial note.</strong> {d.editorial_note}
          </p>
        </aside>
      ) : null
    }

    {/*
      THE LONGER NOTE, AND THE LAYOUT SUPPLIES NOTHING TO IT. No heading, no
      label, no sign-off — the note opens and closes itself. A layout-supplied
      "Editorial note." above a note that opens "Editors' note." says it twice,
      and the editors' words are not the layout's to introduce.

      Paragraphs are split on blank lines rather than rendered as Markdown. The
      note is editors' apparatus in a frontmatter string, not authored body
      text, and running it through the body renderer would let apparatus grow
      headings, images and links that the article's own safe-subset rules
      (R-025) exist to govern. Blank lines are the only structure it needs.
    */}
    {
      d.editors_note ? (
        <aside class="editors-note" aria-label="Editors’ note">
          {d.editors_note
            .split(/\n\s*\n/)
            .map((para) => para.trim())
            .filter(Boolean)
            .map((para) => (
              <p>{para}</p>
            ))}
        </aside>
      ) : null
    }

    <ProvenanceBlock article={article} />
  </article>
</Base>

<style>
  .article-header {
    text-align: center;
    padding: 2.8rem 0 1.8rem;
  }

  .article-title {
    font-size: clamp(1.9rem, 6vw, 2.8rem);
    margin-top: 0.7rem;
  }

  /* Sits tight under the title it attributes — the small margin is the point,
     because the gap is what says the line belongs to the title rather than to
     the byline beneath it. */
  .article-title-attribution {
    font-style: italic;
    font-size: 1.05rem;
    margin: 0.35rem 0 0;
  }

  .article-byline {
    font-style: italic;
    font-size: 1.05rem;
    margin: 0.9rem 0 0;
  }

  /* A plain sentence, as asked — apparatus rather than a badge. It sits at the
     foot of the header in the quiet voice the meta line uses, so it reads as a
     fact about the piece rather than as a label stuck on it. No box, no rule,
     no colour: the one thing that should catch a reader's eye here is the link
     to the question. */
  .article-answers {
    font-size: 0.9rem;
    color: var(--ink-soft);
    /* Tight to the title it belongs with, and giving the byline below it the
       same air the title used to give it directly. */
    margin: 0.6rem 0 0;
  }

  /* Apparatus, not prose: set apart by a rule above it and a smaller, quieter
     face, so a reader can see at a glance that the author did not write it. */
  .editorial-note {
    max-width: 42rem;
    margin: 2.4rem auto 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule, currentColor);
    font-size: 0.92rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .editorial-note p {
    margin: 0;
  }

  /* The longer note. Same voice as the short one — apparatus, set quieter than
     the piece — but it is read rather than scanned, so it keeps the body's
     line height and gets paragraph spacing instead of a single block. */
  .editors-note {
    max-width: 42rem;
    margin: 2.4rem auto 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule, currentColor);
    font-size: 0.92rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .editors-note p {
    margin: 0 0 1rem;
  }

  .editors-note p:last-child {
    margin-bottom: 0;
  }

  .article-meta {
    margin: 0.45rem 0 0;
  }

  .article-figure {
    margin: 0 0 2.2rem;
  }

  .article-figure figcaption {
    margin-top: 0.5rem;
    text-align: right;
  }

  .article-plain-rule {
    width: 6rem;
    margin: 0 auto 2.2rem;
  }
</style>
