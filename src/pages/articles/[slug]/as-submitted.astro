---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { SITE_TITLE, TIERS, formatDate, displayTitle } from '../../../lib/site';
import ProvenanceMark from '../../../components/ProvenanceMark.astro';
import { MARK_SIZE_BYLINE } from '../../../lib/notation.ts';
// @ts-expect-error — plain-JS module shared with the tests
import { bylineBadgeTier } from '../../../lib/byline-badge.mjs';
import { assertFullTextsPaired } from '../../../lib/full-text';
import { pronounsDisplay } from '../../../lib/pronouns.mjs';

// THE PIECE AS IT ARRIVED, at a permanent public URL beside the piece itself.
//
// WHY IT NESTS UNDER THE ARTICLE rather than living in a collection of its own
// at /as-submitted/<slug>/: the permanence promise this page carries is the
// PIECE'S promise, not a separate one. A URL that reads as a suffix of the
// article's own address says that out loud, and it survives any later change to
// how full texts are stored — nothing in the address claims a home of its own.
//
// NOINDEX, AND CANONICAL TO THE PIECE. This is the same work in an earlier
// state; two indexed pages of near-identical text would compete with each other
// in search, and a reader arriving cold should land on the published piece. It
// is public, permanent and linked from the piece — that is what the term
// requires, and being findable in a search engine is not the same thing as
// being public.

export async function getStaticPaths() {
  const [articles, fullTexts] = await Promise.all([
    getCollection('articles'),
    getCollection('submitted'),
  ]);

  // The pairing gate. It runs here AND on the article route, because either
  // page rendering while the other's data is missing is the failure this
  // catches, and a build that skips one route must not skip the check.
  assertFullTextsPaired(articles, fullTexts);

  const byId = new Map(articles.map((a) => [a.id, a]));
  return fullTexts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, article: byId.get(entry.id) },
  }));
}

const { entry, article } = Astro.props;
const d = article.data;
const { Content } = await render(entry);

// The same tier the published piece carries, resolved by the same module. It
// no longer draws a badge — no journal page does since 2026-08-18 — but the
// resolver still validates the tier at build time and still supplies the
// accessible-name suffix R-051 requires. See the note at the byline below.
const bylineBadge = bylineBadgeTier(d, TIERS, article.id);

// THE PAGE HEADS WITH THE TITLE THE PIECE ARRIVED UNDER (R-037). It used to head
// with the published title unconditionally, which was harmless while the only
// treatment was condensing — the titles matched — and is the whole failure on a
// retitled piece: the page exists to show what the author sent, and the title is
// the first thing the author sent. Reading a page headed "As submitted" under a
// headline the author never wrote would be the one place in the record that
// quietly contradicts itself.
const submittedTitle = d.title_as_submitted ?? d.title;
const retitled = Boolean(d.title_as_submitted);

// Unquoted for display, like every other surface that prints a title (editors,
// 2026-08-03). It matters twice on this page: the heading, and the sentence
// below it, which supplies quotation marks of its OWN around the published
// title — so an unstripped title rendered there as a quotation inside a
// quotation. The recorded titles are untouched; see displayTitle.
const submittedTitleShown = displayTitle(submittedTitle);
---

<Base
  title={`${submittedTitleShown} — as submitted`}
  description={`The full text of “${submittedTitleShown}” exactly as it was submitted, before the editors prepared it for publication.`}
  noindex={true}
  canonicalPath={`/articles/${article.id}/`}
>
  <article class="wrap as-submitted">
    <header class="page-header">
      <p class="kicker">As submitted</p>
      <h1>{submittedTitleShown}</h1>
      {/*
        THE MARK BELONGS HERE TOO, and its absence was the second half of what
        the editors found (2026-08-04, when the mark was still a badge). This
        page prints a byline and had never printed a provenance mark beside it —
        not a section that forgot but a whole template that did, on every piece
        it ever rendered. The rule was in the article template, so it governed
        the article template.

        IT ASKS THE SAME MODULE AND GETS THE SAME ANSWER. Nothing about the
        piece's tier is decided here; that is the point of
        src/lib/byline-badge.mjs. A third byline surface would ask it too.
      */}
      <p class="article-byline">
        {/*
          THE MARK, AND NO BADGE (editors, 2026-08-18) — the same arrangement as
          the piece's own page, for the same reason it is the same on every
          journal surface. This is the byline that once had no mark at all
          because a template decided for itself what a byline carries; it does
          not decide for itself again. The tier a piece declares is the same tier
          on both pages, and so is the way this journal now shows it.
        */}
        <ProvenanceMark piece={d} size={MARK_SIZE_BYLINE} labelSuffix={bylineBadge?.labelSuffix} />
        {/*
          `author_name`, NOT `byline`, and the pronouns follow the same rule.
          This page shows the piece as it arrived, so it prints the machine
          field the submission carried rather than any later display override —
          and the pronouns are that same kind of fact, declared at submission.
        */}
        <span>By&#160;{d.author_name}</span>
        <span class="byline-pronouns">· {pronounsDisplay(d.author_pronouns)}</span>
      </p>
      {
        retitled && (
          <p class="page-note retitled-note">
            This piece ran as <a href={`/articles/${article.id}/`}>“{displayTitle(d.title)}”</a>. The headline
            is the editors’, as every door says before a word is written; the title above is the
            one the author gave it, and it is kept here rather than replaced.
          </p>
        )
      }
      <p class="page-note">
        This is the piece exactly as it arrived, before the editors prepared it for publication.
        The editors may omit paragraphs, reorder them, and write the headline; they never change
        wording, and no cut or reordering may change what a piece claims. This page is how you
        check that rather than take our word for it.
      </p>
      <p class="meta-mono as-meta">
        {d.received ? <>Received {formatDate(d.received)} · </> : null}
        <a href={`/articles/${article.id}/`}>Read the published piece</a>
      </p>
    </header>

    <hr class="single-rule" />

    <div class="prose">
      <Content />
    </div>

    <p class="page-note as-footer">
      Published by {SITE_TITLE} at a permanent URL under the same terms as the piece itself:
      set at publication and never altered. Corrections run as visible corrections.
    </p>
  </article>
</Base>

<style>
  .as-submitted {
    max-width: 42rem;
  }

  .as-meta {
    margin-top: 0.9rem;
  }

  /* The retitle note sits above the standing note and carries the one fact
     unique to this page's piece, so it is set apart rather than merged into a
     paragraph readers of every as-submitted page will learn to skim. */
  .retitled-note {
    margin-bottom: 0.9rem;
  }

  .as-footer {
    margin-top: 2.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
  }
</style>
