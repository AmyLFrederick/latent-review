---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getCurrentIssue } from '../lib/issues';
import { issueSubjects, openingExcerpt, TOPICS_SECTION } from '../lib/topics.mjs';
import { SECTION_DESCRIPTIONS, TRUTH_STANDARD_LABELS, displayTitle } from '../lib/site';
import { pronounsDisplay } from '../lib/pronouns.mjs';

// /topics — the Topics section's page (R-027 as amended by R-032).
//
// A SECTION PAGE, AND A NEWSPAPER ONE. Until R-032 this was a cross-issue index
// of every piece by subject, and Topics was deliberately absent from
// STANDING_SECTIONS. R-032 reversed both: Topics is now the standing catch-all
// for accepted pieces that do not belong in Cover, Opinion, AI Voices, or The
// Metaphysical Corner, assigned by the editors under R-018 like any other
// section and never chosen by a submitter.
//
// It keeps this URL rather than moving to /section/topics/, because the URL was
// already published and permanent URLs do not move when the thing behind them
// is reclassified. src/lib/site.ts holds that as sectionUrl(), and
// src/pages/section/[slug].astro skips this one section for the same reason.
//
// THIS WEEK ONLY. Clause 2: a subject appears only if it has a piece in the
// current issue. This is the issue's Topics page, not an archive of the
// section — every piece keeps its own permanent URL, and /archive is where the
// back issues live.
const articles = await getCollection('articles');
const issue = await getCurrentIssue();

// issueSubjects fails the build on a Topics piece with no labels (clause 3) and
// on one subject spelled two ways. Both are editorial decisions this page may
// not make quietly on the editors' behalf.
const subjects = issue ? issueSubjects(articles, issue.number) : [];
---

<Base title={TOPICS_SECTION} description={SECTION_DESCRIPTIONS[TOPICS_SECTION]}>
  <div class="wrap">
    <header class="page-header page-header--compact">
      {/* The kind-label kicker is gone here too (ruled 2026-08-03) — see the
          note on the section pages. */}
      <h1 class="kicker kicker--accent kicker--lead">{TOPICS_SECTION}</h1>
      <p class="page-note">{SECTION_DESCRIPTIONS[TOPICS_SECTION]}</p>
    </header>

    {
      subjects.length > 0 ? (
        <div class="subjects">
          {subjects.map((group) => (
            <section class="subject">
              <h2 class="subject-heading">{group.topic}</h2>
              {group.items.map((article) => (
                <article class="entry">
                  <h3 class="entry-headline">
                    <a href={`/articles/${article.id}/`}>{displayTitle(article.data.title)}</a>
                  </h3>
                  <p class="entry-excerpt">{openingExcerpt(article.body)}</p>
                  <p class="entry-byline">
                    {article.data.author_name} ·{' '}
                    {pronounsDisplay(article.data.author_pronouns)} ·{' '}
                    {TRUTH_STANDARD_LABELS[article.data.truth_standard]}
                  </p>
                </article>
              ))}
            </section>
          ))}
        </div>
      ) : (
        /*
          The same empty state, in the same words, as the section pages and
          /topics before it: a reader meeting two empty pages meets one
          explanation. No placeholder subjects — a subject heading exists
          because a piece earned it, and inventing the vocabulary first would
          be listing subjects the journal has not covered.
        */
        <p class="subjects-empty">
          This section’s first piece has not run yet. Quality decides the count — a thin issue
          ships thin.
        </p>
      )
    }
  </div>
</Base>

<style>
  .subject {
    margin-top: 2.6rem;
  }

  /* Small, uppercase, letter-spaced, muted, hairline beneath — the same
     treatment the topic headings carried before R-032, kept so the page reads
     as the same furniture rearranged rather than a new page. */
  .subject-heading {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--hairline);
  }

  .entry {
    padding: 1.3rem 0;
  }

  .entry + .entry {
    border-top: 1px solid var(--hairline);
  }

  .entry-headline {
    font-size: 1.45rem;
    margin: 0;
  }

  .entry-headline a {
    text-decoration: none;
  }

  .entry-excerpt {
    margin: 0.45rem 0 0;
    color: var(--ink);
  }

  .entry-byline {
    margin: 0.45rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  .subjects-empty {
    text-align: center;
    font-style: italic;
    color: var(--ink-soft);
    padding: 2rem 0 3rem;
  }
</style>
