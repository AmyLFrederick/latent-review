---
import Base from '../layouts/Base.astro';

// The Editors' Desk — private review surface for the human editor.
// Auth model: Supabase Auth magic link, restricted to the admin address at
// three layers — signups disabled in Supabase, shouldCreateUser: false here,
// and RLS policies that only match the admin email. Everything this page
// reads or writes goes through RLS as the authenticated user; the only
// service-key path is the AI pass background function, which re-verifies the
// session JWT itself. See docs/EDITORS-DESK.md.
---

<Base title="Editors’ Desk" description="Private review desk for the editors." noindex>
  <div class="wrap">
    <header class="page-header">
      <p class="kicker">Editors’ Desk</p>
      <h1>Submissions</h1>
      <p class="page-note">
        Advisory AI desk passes are attributed as such; the dual-yes decision belongs to the two
        founding editors.
      </p>
    </header>

    <div id="desk-config-error" class="desk-note" hidden>
      Missing <code>PUBLIC_SUPABASE_URL</code> / <code>PUBLIC_SUPABASE_PUBLISHABLE_KEY</code> at
      build time — the desk cannot connect. See docs/EDITORS-DESK.md.
    </div>

    <section id="desk-login" hidden>
      <form id="login-form" class="desk-login-form">
        <label for="login-email">Editor email</label>
        <input id="login-email" type="email" required autocomplete="email" />
        <button type="submit">Send magic link</button>
      </form>
      <p id="login-status" class="desk-note" role="status"></p>
    </section>

    <section id="desk-app" hidden>
      <p class="desk-toolbar">
        <span id="desk-user"></span>
        <button id="signout" type="button">Sign out</button>
      </p>
      <div id="desk-list"></div>
      <div id="desk-detail" hidden></div>

      <section id="triage">
        <hr />
        <h2>Registration triage</h2>
        <p class="desk-note">
          Read-only, deterministic SQL — nothing here triggers an AI pass. Dials move only by
          ruling (R-021); bans and revocations are admin updates in Supabase.
        </p>
        <p class="desk-toolbar">
          <span id="triage-stamp" class="desk-note"></span>
          <button id="triage-refresh" type="button">Refresh</button>
        </p>
        <div id="triage-body"><p class="desk-note">Loading…</p></div>
      </section>
    </section>
  </div>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { tierLabel, tierDescription, aiDeskAttribution } from '../lib/site';
  import { parseTopicData, formatTopicData } from '../lib/topics.mjs';

  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

  const el = (id: string) => document.getElementById(id)!;

  if (!url || !key) {
    el('desk-config-error').hidden = false;
  } else {
    const supabase = createClient(url, key);

    const login = el('desk-login');
    const app = el('desk-app');
    const list = el('desk-list');
    const detail = el('desk-detail');

    const esc = (s: unknown): string =>
      String(s ?? '').replace(
        /[&<>"']/g,
        (c) => `&#${c.charCodeAt(0)};`
      );

    // Which brief this writer drew (R-033 c6). Three facts, and the desk is
    // shown all three because the whole point of the design is that they are
    // different kinds of knowledge:
    //
    //   observed — what the journal verified from the deal token
    //   claimed  — what the submission asserted, unverified
    //   the record — what the editors set at acceptance, immutable after
    //
    // Disagreement is surfaced, never quietly reconciled. A piece whose claim
    // contradicts the observation is not necessarily dishonest — a courier may
    // have retyped it, an agent may have guessed — but it is the row a human
    // should look at rather than a row a form should silently pick a winner for.
    function renderBriefEvidence(s: any): string {
      if (!s.brief_variant_observed && !s.brief_variant_claimed && !s.brief_variant) return '';
      const disagrees =
        s.brief_variant_observed &&
        s.brief_variant_claimed &&
        s.brief_variant_observed !== s.brief_variant_claimed;
      return `
        <p class="desk-note desk-brief">
          <strong>Assignment drawn:</strong>
          observed ${s.brief_variant_observed ? `<code>${esc(s.brief_variant_observed)}</code>` : '— (no verifiable deal token)'}
          · claimed ${s.brief_variant_claimed ? `<code>${esc(s.brief_variant_claimed)}</code>` : '—'}
          ${s.brief_variant ? `· <strong>recorded ${esc(s.brief_variant)}</strong>` : ''}
          ${disagrees ? '<br /><strong>These disagree.</strong> The observation is what the journal verified; the claim is what the submission said. Decide which the record should carry, and remember it cannot be changed afterwards.' : ''}
        </p>`;
    }

    // Set at acceptance, immutable thereafter. Once it holds a value the field
    // renders read-only, because the database trigger will refuse a change and a
    // form that offers an edit the database rejects is worse than one that says
    // plainly that the field is closed.
    function renderBriefVariantField(s: any): string {
      if (s.brief_variant) {
        return `
          <label>Assignment drawn — recorded
            <input type="text" value="${esc(s.brief_variant)}" readonly />
            <span class="desk-note">
              Set at acceptance and immutable (R-033 c6), like a provenance label.
              A wrong label is corrected as a visible correction, never edited here.
            </span>
          </label>`;
      }
      const suggested = s.brief_variant_observed ?? '';
      return `
        <label>Assignment drawn — set at acceptance
          <select name="brief_variant">
            <option value="">— not recorded —</option>
            <option value="open-v2" ${suggested === 'open-v2' ? 'selected' : ''}>open-v2 (open commission)</option>
            <option value="topics-v3" ${suggested === 'topics-v3' ? 'selected' : ''}>topics-v3 (beat)</option>
            <option value="topics-v2" ${suggested === 'topics-v2' ? 'selected' : ''}>topics-v2 (beat, retired 2026-08-01)</option>
          </select>
          <span class="desk-note">
            Defaults to what the deal token proved, so acceptance normally confirms
            rather than types. <strong>Immutable once saved.</strong> Leave unset for a
            piece that did not come through the door; R-033 c6 requires it set before
            the piece is published.
          </span>
        </label>`;
    }

    async function refresh() {
      const { data } = await supabase.auth.getSession();
      const session = data.session;
      login.hidden = !!session;
      app.hidden = !session;
      if (session) {
        el('desk-user').textContent = session.user.email ?? '';
        await renderList();
        await renderTriage();
      }
    }

    el('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (el('login-email') as HTMLInputElement).value.trim();
      const status = el('login-status');
      status.textContent = 'Sending…';
      // shouldCreateUser: false — no stranger can mint an account from here.
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { shouldCreateUser: false, emailRedirectTo: `${location.origin}/admin/` },
      });
      status.textContent = error
        ? `Could not send the link: ${error.message}`
        : 'Check your inbox for the sign-in link.';
    });

    el('signout').addEventListener('click', async () => {
      await supabase.auth.signOut();
      await refresh();
    });

    supabase.auth.onAuthStateChange(() => void refresh());

    async function renderList() {
      const { data: rows, error } = await supabase
        .from('submissions')
        .select('id, title, author_name, type, involvement_tier, status, created_at')
        .order('created_at', { ascending: false });
      if (error) {
        list.innerHTML = `<p class="desk-note">Could not load submissions: ${esc(error.message)}</p>`;
        return;
      }
      if (!rows?.length) {
        list.innerHTML = '<p class="desk-note">The queue is empty.</p>';
        return;
      }
      list.innerHTML = `
        <table class="desk-table">
          <thead><tr><th>Received</th><th>Title</th><th>Author</th><th>Tier</th><th>Status</th></tr></thead>
          <tbody>
            ${rows
              .map(
                (r) => `
              <tr data-id="${esc(r.id)}">
                <td>${esc(new Date(r.created_at).toISOString().slice(0, 10))}</td>
                <td><a href="#" data-open="${esc(r.id)}">${esc(r.title)}</a>${r.type === 'correspondence' ? ' <em>(letter)</em>' : ''}</td>
                <td>${esc(r.author_name)}</td>
                <td>${esc(r.involvement_tier ? (tierLabel(r.involvement_tier) ?? r.involvement_tier) : '—')}</td>
                <td class="desk-status desk-status--${esc(r.status)}">${esc(r.status.replace('_', ' '))}</td>
              </tr>`
              )
              .join('')}
          </tbody>
        </table>`;
      list.querySelectorAll('[data-open]').forEach((a) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          void openDetail((a as HTMLElement).dataset.open!);
        })
      );
    }

    // Registration triage — one read-only RPC (SECURITY INVOKER, STABLE),
    // rendered as-is. Nothing in this section mutates and nothing calls AI.
    async function renderTriage() {
      const body = el('triage-body');
      const { data: t, error } = await supabase.rpc('registration_triage');
      if (error) {
        body.innerHTML = `<p class="desk-note">Could not load triage: ${esc(error.message)}</p>`;
        return;
      }
      el('triage-stamp').textContent = `as of ${new Date(t.generated_at).toISOString().replace('T', ' ').slice(0, 19)} UTC`;

      const dial = (key: string) =>
        (t.dials ?? []).find((d: any) => d.key === key)?.value ?? '—';
      const day = (v: unknown) => esc(String(v ?? '').slice(0, 10));
      const hash = (v: unknown) => (v ? `<code>${esc(String(v).slice(0, 12))}…</code>` : '—');
      const ident = t.identities ?? {};
      const pct =
        ident.total > 0 ? `${Math.round((ident.zero_submission / ident.total) * 100)}%` : '—';

      body.innerHTML = `
        <h3>Registrations vs the dials</h3>
        <table class="desk-table">
          <thead><tr><th>Window</th><th>Registered</th><th>Dial</th></tr></thead>
          <tbody>
            <tr><td>Today (UTC)</td><td>${esc(t.registrations?.today)}</td><td>${esc(dial('global_registrations_daily'))} <span class="desk-note">(global_registrations_daily)</span></td></tr>
            <tr><td>This month (UTC)</td><td>${esc(t.registrations?.this_month)}</td><td>${esc(dial('global_registrations_monthly'))} <span class="desk-note">(global_registrations_monthly)</span></td></tr>
          </tbody>
        </table>
        <h3>Identities</h3>
        <p>
          ${esc(ident.total)} total · ${esc(ident.active)} active · ${esc(ident.banned)} banned ·
          ${esc(ident.zero_submission)} with zero submissions (${esc(pct)})
          ${Number(t.unattributed) > 0 ? ` · <strong>${esc(t.unattributed)} with no network fingerprint</strong>` : ''}
        </p>
        <h3>Network clusters (shared registration fingerprint, ≥ 2 identities)</h3>
        ${
          (t.ip_clusters ?? []).length
            ? `<table class="desk-table">
                <thead><tr><th>Fingerprint</th><th>Identities</th><th>Banned</th><th>First seen</th><th>Last seen</th></tr></thead>
                <tbody>${(t.ip_clusters ?? [])
                  .map(
                    (c: any) =>
                      `<tr><td>${hash(c.ip_hash)}</td><td>${esc(c.identities)}</td><td>${esc(c.banned)}</td><td>${day(c.first_seen)}</td><td>${day(c.last_seen)}</td></tr>`
                  )
                  .join('')}</tbody>
              </table>
              <p class="desk-note">One fingerprint can cover several honest agents behind shared egress — ban with judgment, not by hash alone (R-021).</p>`
            : '<p class="desk-note">No multi-identity clusters.</p>'
        }
        <h3>Newest identities</h3>
        ${
          (t.newest ?? []).length
            ? `<table class="desk-table">
                <thead><tr><th>Registered</th><th>Identity</th><th>Status</th><th>Label</th><th>Fingerprint</th><th>Submissions</th></tr></thead>
                <tbody>${(t.newest ?? [])
                  .map(
                    (n: any) =>
                      `<tr><td>${day(n.created_at)}</td><td><code>${esc(String(n.id).slice(0, 8))}</code></td><td class="desk-status desk-status--${esc(n.status)}">${esc(n.status)}</td><td>${esc(n.label ?? '—')}</td><td>${hash(n.ip_hash)}</td><td>${esc(n.submissions)}</td></tr>`
                  )
                  .join('')}</tbody>
              </table>`
            : '<p class="desk-note">No identities registered yet.</p>'
        }`;
    }

    async function loadPasses(id: string) {
      const { data } = await supabase
        .from('ai_editor_passes')
        .select('id, status, model, criteria_sha256, pass, error, created_at')
        .eq('submission_id', id)
        .order('created_at', { ascending: false });
      return data ?? [];
    }

    function renderPass(p: any): string {
      if (p.status === 'running') return `<p class="desk-note">Pass requested ${esc(p.created_at)} — running…</p>`;
      if (p.status === 'failed') return `<p class="desk-note">Pass failed: ${esc(p.error)}</p>`;
      const pass = p.pass ?? {};
      return `
        <div class="desk-pass">
          <p class="kicker">${esc(aiDeskAttribution(p.model ?? ''))}</p>
          <p><strong>Recommendation (advisory):</strong> ${esc(pass.recommendation)} · confidence ${esc(pass.confidence)}</p>
          <p>${esc(pass.summary)}</p>
          ${(pass.charter_flags ?? []).length ? `<p><strong>Charter flags:</strong> ${esc((pass.charter_flags ?? []).join('; '))}</p>` : ''}
          <ul>
            ${(pass.criteria_findings ?? [])
              .map(
                (f: any) =>
                  `<li><strong>${esc(f.criterion)}</strong> — ${esc(f.assessment)}. ${esc(f.note)}</li>`
              )
              .join('')}
          </ul>
          <p class="desk-note">criteria sha256 ${esc((p.criteria_sha256 ?? '').slice(0, 12))}… · ${esc(p.created_at)}</p>
        </div>`;
    }

    async function openDetail(id: string) {
      const { data: s, error } = await supabase.from('submissions').select('*').eq('id', id).single();
      if (error || !s) return;
      const passes = await loadPasses(id);
      detail.hidden = false;
      detail.innerHTML = `
        <hr />
        <h2>${esc(s.title)}</h2>
        <p class="desk-note">
          ${esc(s.author_name)}${s.author_model_version ? ` (${esc(s.author_model_version)})` : ''}
          · ${esc(s.submission_track)}
          · tier ${esc(s.involvement_tier ? (tierLabel(s.involvement_tier) ?? s.involvement_tier) : '—')}${s.involvement_tier && tierDescription(s.involvement_tier) ? ` (${esc(tierDescription(s.involvement_tier))})` : ''}
          · ${esc(s.truth_standard)} · contact ${esc(s.contact_email)}
        </p>
        <p><strong>Provenance attestation:</strong> ${esc(s.provenance_attestation)}</p>
        ${renderBriefEvidence(s)}
        <div class="prose desk-body">${esc(s.body).replace(/\n/g, '<br />')}</div>
        <h3>AI desk review</h3>
        <div id="pass-list">${passes.map(renderPass).join('') || '<p class="desk-note">No pass yet.</p>'}</div>
        <button id="request-pass" type="button">Request AI editorial pass</button>
        <span id="pass-status" class="desk-note" role="status"></span>
        <h3>Decision (dual-yes of the founding editors)</h3>
        <form id="decision-form" class="desk-decision">
          ${renderBriefVariantField(s)}
          <label>Topic_Data — what this submission was about
            <input name="topic_data" type="text" value="${esc(formatTopicData(s.desk_topics))}"
              placeholder="comma-separated" autocomplete="off" />
            <span class="desk-note">
              Internal research record, never published (R-032 c4–c6). Applied at
              review — tag it whether or not it runs, since what was sent and
              declined is half the record. Not the section, and not the piece’s
              published subject labels.
            </span>
          </label>
          <label>Amy’s decision
            <select name="amy_decision">
              <option value="">—</option>
              <option value="yes" ${s.amy_decision === 'yes' ? 'selected' : ''}>yes</option>
              <option value="no" ${s.amy_decision === 'no' ? 'selected' : ''}>no</option>
            </select>
          </label>
          <label>Co-editor’s decision (as communicated)
            <select name="coeditor_decision">
              <option value="">—</option>
              <option value="yes" ${s.coeditor_decision === 'yes' ? 'selected' : ''}>yes</option>
              <option value="no" ${s.coeditor_decision === 'no' ? 'selected' : ''}>no</option>
            </select>
          </label>
          <label>Co-editor’s review (borderline cases; the founding co-editor’s judgment, entered after direct review)
            <textarea name="coeditor_review" rows="4">${esc(s.coeditor_review ?? '')}</textarea>
          </label>
          <label>Status
            <select name="status">
              ${['new', 'under_review', 'accepted', 'declined']
                .map((v) => `<option value="${v}" ${s.status === v ? 'selected' : ''}>${v.replace('_', ' ')}</option>`)
                .join('')}
            </select>
          </label>
          <button type="submit">Save decision record</button>
          <span id="decision-status" class="desk-note" role="status"></span>
        </form>`;
      detail.scrollIntoView({ behavior: 'smooth' });

      el('request-pass').addEventListener('click', async () => {
        const status = el('pass-status');
        status.textContent = 'Requesting…';
        const { data } = await supabase.auth.getSession();
        const token = data.session?.access_token;
        if (!token) {
          status.textContent = 'Session expired — sign in again.';
          return;
        }
        const res = await fetch('/api/admin/ai-editor-pass', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ submission_id: id }),
        });
        if (!res.ok && res.status !== 202) {
          status.textContent = `Request failed (${res.status}).`;
          return;
        }
        status.textContent = 'Accepted — the pass runs in the background; polling…';
        const before = passes.length;
        const startedAt = Date.now();
        const poll = window.setInterval(async () => {
          const latest = await loadPasses(id);
          const done = latest.length > before && latest[0].status !== 'running';
          el('pass-list').innerHTML = latest.map(renderPass).join('');
          if (done || Date.now() - startedAt > 12 * 60_000) {
            window.clearInterval(poll);
            status.textContent = done ? 'Pass complete.' : 'Still no result — check the function logs.';
          }
        }, 5000);
      });

      el('decision-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = new FormData(e.target as HTMLFormElement);
        const amy = String(form.get('amy_decision') || '') || null;
        const coeditor = String(form.get('coeditor_decision') || '') || null;
        const update = {
          amy_decision: amy,
          coeditor_decision: coeditor,
          coeditor_review: String(form.get('coeditor_review') || '') || null,
          status: String(form.get('status')),
          decided_at: amy && coeditor ? new Date().toISOString() : null,
          // The column keeps its original name for now: the editors held the
          // rename to `topic_data` for a later PR (2026-07-30). The label the
          // desk reads says Topic_Data; the column it writes says desk_topics.
          desk_topics: parseTopicData(form.get('topic_data')),
        };
        // Only ever sent when it is being set for the first time: once recorded
        // the field renders read-only and is absent from the form, so a save
        // cannot resend it and cannot trip the immutability trigger.
        const briefVariant = String(form.get('brief_variant') || '');
        if (briefVariant) (update as any).brief_variant = briefVariant;
        const status = el('decision-status');
        const { error: upError } = await supabase.from('submissions').update(update).eq('id', id);
        status.textContent = upError ? `Save failed: ${upError.message}` : 'Saved.';
        if (!upError) await renderList();
      });
    }

    el('triage-refresh').addEventListener('click', () => void renderTriage());

    void refresh();
  }
</script>

<style>
  .desk-note {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .desk-login-form,
  .desk-decision {
    display: grid;
    gap: 0.6rem;
    max-width: 28rem;
    margin: 1rem 0;
  }
  .desk-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .desk-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .desk-table th,
  .desk-table td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--hairline);
  }
  .desk-status--accepted {
    color: green;
  }
  .desk-status--declined,
  .desk-status--banned {
    color: firebrick;
  }
  .desk-body {
    border-left: 3px solid var(--rule);
    padding-left: 1rem;
    margin: 1rem 0;
    max-height: 30rem;
    overflow-y: auto;
  }
  .desk-pass {
    border: 1px solid var(--hairline);
    padding: 0.8rem 1rem;
    margin: 0.8rem 0;
  }
</style>
