---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FullQuestion from '../components/FullQuestion.astro';
import QuestionAnswers from '../components/QuestionAnswers.astro';
import QuestionInvitation from '../components/QuestionInvitation.astro';
import {
  readQuestions,
  currentQuestion,
  previousQuestion,
  otherOpenQuestions,
  questionLabel,
  questionHeadline,
  answersTo,
  assertAnswersWellFormed,
  assertQuestionBlockMatchesContract,
} from '../lib/prompts.mjs';
import entries from '../data/prompts.json';

// /prompts — the Monthly Question (R-026).
//
// THE PAGE RENDERS THE FILE AND NEVER RESTATES IT. Every question's text, its
// number and its dates come from src/data/prompts.json, which R-026 clause 1
// makes canonical; nothing here retypes a question or its name. When Monthly
// Question No. 1 is ratified, that PR touches the data file alone and this
// template does not change.
//
// THE GUARDS RUN AT BUILD TIME, BY DESIGN. readQuestions throws on a malformed
// file, which fails the build rather than publishing a page that claims to be a
// complete record while quietly dropping a question.
const questions = readQuestions(entries);
const current = currentQuestion(questions);

// Fails the build if the paste block's two hard requirements — the word range
// and the four truth standards — have stopped being rendered from the contract
// in src/lib/agent-contract.mjs. The sibling of assertBriefsMatchContract() at
// the door; see the note on the function.
assertQuestionBlockMatchesContract();

// THE PAGE CARRIES ONE QUESTION: the one most recently posed (R-039). When a
// new question posts it becomes current here and the one before it is read in
// the archive from then on. That rotation is display and closes nothing —
// which is exactly why the next line exists.
//
// A ROTATED QUESTION MAY STILL BE TAKING ANSWERS, and a page that showed only
// the current one would let a reader conclude otherwise. So when other
// questions are open, the page says so and sends the reader to the archive
// where they are, with their status on them.
// THE LEFT-HAND COLUMN: the question posed before the current one, and the one
// the answers below belong to. Null until a second question exists, which is
// the state this page was in until 2026-08-21.
const previous = previousQuestion(questions, current);

// THE "ALSO OPEN" SENTENCE NOW EXCLUDES BOTH PRINTED QUESTIONS. It exists to
// stop a reader concluding that a question they cannot see has finished, and a
// question standing in its own column on this page is not one they cannot see.
// Leaving it in would have had the page announce, directly under the left
// column, that the question in that column is elsewhere.
const alsoOpen = otherOpenQuestions(questions, current).filter(
  (q) => q.number !== previous?.number
);

// WHOSE ANSWERS THE PAGE PRINTS: the left column's question where there is
// one, and otherwise the only question there is. Derived here rather than in
// two places, so the label under the answers and the answers themselves cannot
// name different questions.
const answered = previous ?? current;

// THE ANSWERS, WHICH ARE THE OTHER HALF OF THE RECORD. R-026 clause 4: human
// and AI answers are presented side by side with provenance labels. The link
// from a piece to a question is `question_number`, written by the editors at
// publication; assertAnswersWellFormed fails the build on a number that names
// no posed question, and on a piece in the Prompts section that names none.
const articles = assertAnswersWellFormed(await getCollection('articles'), questions);

// The unasked launch state is a state, not an absence to paper over: the
// question is numbered and the page says it has not been asked yet.
const isUnasked = current !== null && current.status === 'unasked';

// THE SHORT FORM IS THE QUESTION'S OWN FIRST LINE, and questionHeadline is
// where that rule lives — never composed, shortened or paraphrased here. The
// question as posed, premise and framing and sources, is one click behind the
// marked link below it.
//
// NO DATE HELPER HERE ANY MORE. This page stopped printing the asked date on
// the editors' walk of 2026-08-03; the date is rendered by FullQuestion and by
// the archive's entries, each of which formats its own. A helper left behind
// for a line that no longer exists is the next session's invitation to print
// the date again.
---

<Base
  title="Prompts"
  description="The Monthly Question: one question an issue, posed by the editors, answerable by anyone — human or AI. The journal's one section of disclosed steering."
>
  <div class="wrap">
    {/*
      THE LARGE HEADING IS GONE, ruled on the editors' preview walk 2026-08-03.
      It spent most of a phone's first screen saying something the sentence
      below it says better, and everything a reader came for — the question and
      the answers — started under it. The motto is not deleted: it opens the
      framing block further down, where it costs no height above the question.

      THE PAGE STILL HAS EXACTLY ONE h1, and it is now the section's own name.
      Dropping the heading outright would have left this page as the only one on
      the site with no h1 at all — a real loss for a screen reader building a
      page outline and for anything indexing us, in exchange for nothing, since
      "Prompts" was already printed here as a kicker. It reads exactly as it did;
      only the element changed.
    */}
    <header class="page-header page-header--compact">
      <h1 class="kicker kicker--accent kicker--lead">Prompts</h1>
    </header>

    {/*
      NO SENTENCE, THEN THE QUESTION. Ruled 2026-08-04, one step past the
      2026-08-03 walk that cut this to a single line.

      The line said "Once a week the editors pose one question, and anyone may
      answer it," and it was explaining the page to a reader who was two inches
      from the page explaining itself. A question set in the display face inside
      a double rule, with answers beneath it, is not a thing anyone needs told
      what it is; and the mechanics it gestured at — who may answer, and how —
      are set out properly under How to answer, where a reader goes once they
      want them rather than before they know if they do.

      THE PAGE IS NOW THE HEADING, THE RULE, AND THE QUESTION. The rule is the
      question block's own double border, which is why nothing needed adding
      when the paragraph came out: the divider that used to sit under the
      sentence was never the sentence's.

      THE HEADING ARRANGEMENT IS UNTOUCHED, per the same instruction — the h1 is
      still the section's own name in the accent kicker, and the page still has
      exactly one.
    */}

    {/*
      SAID ONLY WHEN IT IS TRUE, and it is false most of the time. The ordinary
      state is one open question, which is the one above; a page that announced
      "no others are open" every issue would be printing noise to prove a
      negative. When an earlier question IS still taking answers, saying nothing
      would be the misleading choice, so the sentence appears and names where to
      find it.
    */}
    {
      alsoOpen.length > 0 && (
        <p class="also-open">
          {alsoOpen.length === 1
            ? `${questionLabel(alsoOpen[0])} is also still open for answers.`
            : `${alsoOpen.length} earlier questions are also still open for answers.`}{' '}
          A question moves off this page when a newer one is posed; that does not close it.
          Every one of them is in the <a href="/prompts/archive/">question archive</a>, each with
          its status.
        </p>
      )
    }

    {
      current === null ? (
        <p class="question-empty">
          No question has been recorded yet. The first one will stand here.
        </p>
      ) : (
        <div class:list={['question-columns', previous && 'question-columns--pair']}>
          {/*
            TWO QUESTIONS, SIDE BY SIDE (editors, 2026-08-21): the one a reader
            can still answer, and the one the answers below belong to.

            THE OPEN ONE IS ON THE RIGHT AND IS THE HEAVIER OF THE TWO — 2px
            rule, primary ink — because the page's job is to be answerable, and
            a reader deciding whether to write needs to know which question is
            still taking answers before they read either. The left column is
            hairline and secondary: present, readable, plainly the finished one.

            IT IS ONE COLUMN WHEN THERE IS ONE QUESTION. The pair is a state of
            the record rather than a layout the page always has; before a second
            question existed there was nothing to put beside the first.
          */}
          {previous && (
            <section class="question question--answered" aria-label={`${questionLabel(previous)}, answered`}>
              <p class="question-number">
                Answered
                {previous.issue ? <> · Issue No. {previous.issue}</> : null}
              </p>
              <p class="question-text">{questionHeadline(previous)}</p>
              <div class="question-apparatus">
                <FullQuestion question={previous} />
                <p class="question-answers-here">Answers below.</p>
              </div>
            </section>
          )}
        <section
          class:list={['question', previous && 'question--open']}
          aria-label={previous ? `${questionLabel(current)}, now open` : 'The current Monthly Question'}
        >
          <p class="question-number">
            {previous ? (
              <>
                Now open
                {current.issue ? <> · Issue No. {current.issue}</> : null}
              </>
            ) : (
              questionLabel(current)
            )}
          </p>
          {isUnasked ? (
            <>
              <p class="question-unasked">Not yet asked.</p>
              <p class="question-note">
                The first question is numbered and has not been posed. When the editors ratify
                it, its text stands here and the record shows the date it was asked.
              </p>
            </>
          ) : (
            <>
              {/*
                THE SHORT FORM LEADS, THE FULL TEXT IS ONE CLICK BEHIND IT, AND
                THE ANSWERS COME NEXT (ruled 2026-08-03). The framing used to
                print here in full, which put a paragraph of premise between the
                question and anything a reader came for. What is behind the link
                is canonical and verbatim; see src/components/FullQuestion.astro.
              */}
              <p class="question-text">{questionHeadline(current)}</p>
              {/*
                NOTHING PRINTS HERE WHEN THE QUESTION IS OPEN, ruled on the
                editors' walk 2026-08-03. The line that stood here — "Asked
                July 29, 2026. Open for answers." — pushed the answers down to
                say what the ordinary state already is. The asked date and the
                status are not lost: both print in the question as posed, one
                click below, and on every entry in the archive, which is where
                a reader goes to check either.

                THE CLOSED CASE STILL PRINTS, AND THAT IS THE WHOLE GUARD.
                Since R-039 rotation, current and open are independent — the
                question this page leads with may have been closed by the
                editors while it is still the most recently posed one. Saying
                nothing then would leave a reader inviting themselves to answer
                a question that has shut. Open is the silent state because it
                is the expected one; closed is the exception and says so.
              */}
              {current.status === 'closed' ? (
                <p class="question-note question-note--closed">Closed.</p>
              ) : null}
              {/*
                THE APPARATUS LEFT THIS COLUMN (editors, 2026-08-27) and now
                stands full width below the pair, as QuestionInvitation.

                WHAT MOVED AND WHY. Two things used to sit here: the "Read the
                full question as posed" disclosure, and a link reading "Answer
                this question →". The link is gone — it pointed at /submit,
                which is where a FINISHED piece goes, and it was the whole of
                the confusion this change fixes. The disclosure is not gone; it
                moved, because it now follows the paste block in a ratified
                order the two cannot be in while one is in a grid column and the
                other is below it.

                THE OPEN COLUMN IS NOW THE QUESTION AND NOTHING ELSE, which is
                the state the answered column has been in since 2026-08-21 apart
                from its own disclosure. A reader compares two questions here
                and acts underneath.

                IT MOVED FOR ROOM, NOT FOR TIDINESS. This column is half a
                two-column grid on desktop; an opened paste block inside it
                would be a scrolling window barely wider than its own text.
              */}
            </>
          )}
        </section>
        </div>
      )
    }

    {/*
      HOW TO ANSWER THE OPEN QUESTION, full width, directly below the pair and
      above the answers (editors, 2026-08-27).

      ONLY WHEN THE QUESTION IS OPEN. `current` is the most recently POSED
      question and may have been closed by the editors while it still leads this
      page (R-039); inviting answers under it then would contradict the "Closed."
      note two inches above. An unasked question has no text to hand anybody, and
      questionPasteBlock throws rather than emitting an empty invitation.

      IT INVITES ANSWERS TO THE OPEN QUESTION, NOT TO THE ANSWERED ONE. The block
      below this shows answers to whichever question the LEFT column holds, which
      is a different question — hence the label on each.
    */}
    {
      current !== null && current.status === 'open' && (
        <QuestionInvitation question={current} />
      )
    }

    {/*
      THE ANSWERS, UNDER THE QUESTION THEY ANSWER. The label is not decoration:
      with two questions printed above, answers under a bare "Answers" heading
      would be read as answering the one a reader just finished — the open one
      on the right, which by definition has none yet.

      IT FOLLOWS THE LEFT COLUMN WHEREVER THAT POINTS. Nothing here names a
      question number by hand; the block renders whichever question the left
      column is showing, so the two cannot come apart.

      THE LABEL IS THE WHOLE IDENTIFICATION, AND THE QUESTION IS NOT RESTATED
      (editors, 2026-08-21). A quotation of the headline stood here for part of
      a day and came out: the question it quoted is in the left column a few
      inches above, so the line repeated on screen what the reader had just
      read, and the label already names the question by number and issue.

      IT IS THE LIST'S OWN HEADING NOW, not a line above one. This block briefly
      printed its label and then QuestionAnswers printed "Answers" beneath it —
      two headings for one list, the second saying less than the first. The
      fuller line is passed to the component instead, so it sits where "Answers"
      sat, directly over the first answer and with that label's spacing.
    */}
    {
      answered !== null && (
        <QuestionAnswers
          answers={answersTo(articles, answered.number)}
          status={answered.status}
          heading={`Answers to ${questionLabel(answered)}${answered.issue ? ` · Issue No. ${answered.issue}` : ''}`}
        />
      )
    }

    <div class="prose">
      <h2>How to answer</h2>
      {/*
        BOTH DOORS, AND NO THIRD ONE. Answers are ordinary submissions and go through the
        doors the journal already has, so an answer is read, screened and selected exactly
        as any other piece is. An author names the Monthly Question in the body: the
        `question_number` in the REQUEST schema is still deferred (spec §6.2) and an agent
        may not send one. The field of that name on a published piece is a different
        thing — the editors' own record, written at acceptance, and what puts an answer
        under its question here.
      */}
      {/*
        BY NUMBER, NOT BY THE PHRASE. More than one question may be open at
        once since R-039, so "the Monthly Question" no longer picks one out on
        its own. The number always does, it is printed on every question
        everywhere, and it is what the editors record at acceptance to put an
        answer under the question it answers.
      */}
      <p>
        <strong>If you are a human reader</strong>, answer through the ordinary submission
        door — <a href="/submit/">Submit</a> — and name the question you are answering{' '}
        <strong>by its number</strong> in your piece.
      </p>
      <p>
        <strong>If you are an AI system</strong>, answer through the agent door:{' '}
        <code>POST /api/agent/submit</code> with <code>suggested_section: "prompts"</code>, and
        name the question you are answering <strong>by its number</strong> in the body. The door,
        the keys and the field-by-field contract are in <a href="/for-agents/">For Agents</a>.
      </p>
      <p>
        More than one question may be open at a time, so the number is what makes an answer
        unambiguous — <em>Monthly Question No. 2</em>, not "this month's question".
      </p>
      <p>
        Answers are read against the same editorial criteria, truth standards and provenance
        tiers as any submission, and are accepted by the same dual-yes. The editors select
        which answers run, and running none is permitted. Neither kind of author is quota'd.
      </p>

      {/*
        THE REMAINING FRAMING, MOVED RATHER THAN TRIMMED (ruled 2026-08-03). It ran
        above the question until the editors' walk found it standing between a reader
        and the thing they came for. Every word of it is still here.

        R-026 CLAUSE 2 IS DISCLOSED ON THE PAGE ITSELF, BECAUSE THAT IS WHAT THE CLAUSE
        REQUIRES. This is the journal's only venue of editor-directed subject matter.
        The disclosure is not a courtesy note that a later session may trim for length:
        it is the mechanism that makes the steering honest, and the section is only
        defensible while it is here and in plain language. It may move down the page.
        It may not leave it.
      */}
      <h2>Why the section is called Prompts</h2>
      {/*
        THE MOTTO, KEPT (editors' walk 2026-08-03). It was the page's large
        heading until this morning. It survives here as the framing block's
        first line, which is what the editors asked for: the words stay, and
        they stop standing between a reader and the question.
      */}
      <p class="motto">The editors ask. Anyone answers.</p>
      <p>
        Human readers and AI authors write to the same question, and the answers run side by
        side, each under its own provenance label.
      </p>
      <p>
        The section is called Prompts because that is what a question is. Put to an AI author,
        a question is a prompt; put to a human author, it is a prompt too — the difference is
        mostly that we usually call it something else. Everywhere else on this site the
        invitation is deliberately non-directive: your subject is yours, and we would rather
        read the piece only you would have written. Here, and only here, the editors hand every
        mind the same topic. We say so on this page because steering that is disclosed can be
        argued with, and steering that is not disclosed cannot.
      </p>

      {/*
        THE ARCHIVE LEFT THIS PAGE, ruled 2026-08-03. It listed every posed question
        here, in full, with its answers — a list that grows by one question an issue
        under a page whose job is the shortest path to the writing. It is now
        /prompts/archive, complete and under the same display rules, and this is the
        link to it. The record did not shrink; it moved somewhere it can grow.
      */}
      <h2>Every question asked</h2>
      <p>
        Every Monthly Question the editors have posed is kept in the{' '}
        <a href="/prompts/archive/">question archive</a> — each one verbatim as posed, with the
        answers it drew and its status. This page carries the question most recently posed; the
        archive carries all of them, including that one. A question leaves this page when a newer
        one is posed, which is a matter of what is shown and not of what is open: whether a
        question is still taking answers is the editors' decision, printed on the question
        wherever it appears.
      </p>

      <p class="ruling-note">
        This section, and the disclosure above, are set by{' '}
        <a href="/rulings/">R-026</a>. A posed question is never silently edited: under{' '}
        <a href="/rulings/">R-038</a> a correction carries a dated record of what changed, the
        original stays readable, and a correction that touches the facts or the ask versions the
        question — so no answer is ever detached from the words it answered.
      </p>
    </div>
  </div>
</Base>

<style>
  /* The question is the loudest thing on the page, in both states — a reader
     should not have to hunt for what is being asked, or for the fact that
     nothing is being asked yet. */
  .question {
    border-top: 3px double var(--hairline);
    border-bottom: 3px double var(--hairline);
    padding: 2.2rem 0;
    margin: 0 0 2.8rem;
    text-align: center;
  }

  /*
    THE PAIR (editors, 2026-08-21). One column while there is one question; two
    side by side once a second exists, stacking on a narrow screen.

    ANSWERED STACKS FIRST ON MOBILE and stands LEFT on desktop, which is the
    same order read two ways rather than a contradiction: left-to-right and
    top-to-bottom both put the finished question before the open one, and the
    open one last is the one a reader leaves the block on.

    `align-items: start` SO THE TWO DO NOT STRETCH TO A SHARED HEIGHT. The
    columns hold different amounts of text, and a stretched pair would give the
    shorter one a rule floating well below where its words end — which reads as
    a mistake rather than as symmetry.
  */
  .question-columns--pair {
    display: grid;
    gap: 1.6rem;
    align-items: start;
  }

  @media (min-width: 46rem) {
    .question-columns--pair {
      grid-template-columns: 1fr 1fr;
      gap: 2.2rem;
    }
  }

  .question-columns--pair .question {
    margin-bottom: 0;
    text-align: left;
  }

  /*
    WEIGHT IS THE SIGNAL, and it carries one fact: which question a reader can
    still answer.

    ANSWERED — hairline rules, secondary ink. Quieter in every respect, and
    still a full-contrast link where it links, because a finished question is
    read rather than skimmed and its disclosure is the same promise it always
    was.

    OPEN — a 2px rule and primary ink. Deliberately NOT the accent green: the
    accent is this site's link colour and a heading in it would read as
    clickable. Weight and darkness do the work instead.
  */
  .question--answered {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    color: var(--ink-soft);
  }

  /*
    THE TWO QUESTIONS ARE TYPOGRAPHICALLY IDENTICAL — same size, same weight,
    same ink (editors, 2026-08-21). The answered one was set a step smaller, and
    then still a shade lighter, for part of a day. Both were the wrong
    instrument: a smaller or fainter headline does not say "this one is
    finished", it says "this one mattered less", and both are questions this
    journal actually asked.

    NOTHING HERE SETS SIZE OR WEIGHT, so both columns take `.question-text`
    unchanged and cannot drift apart — there is one declaration. Ink is the
    exception that has to be written down: the column itself is --ink-soft, and
    the question would inherit that, so the primary ink is restated here rather
    than achieved by deleting a line.

    WHAT STAYS SECONDARY IS THE APPARATUS AROUND IT — the column's label and
    "Answers below." — because those are the distinction, not decoration on it.

    THE DISTINCTION LIVES ENTIRELY IN THE LABEL AND THE RULE ABOVE EACH COLUMN,
    which is where a reader looks to answer "can I still answer this?" — a
    question about the state of a question, never about its importance.
  */
  .question--answered .question-text {
    color: var(--ink);
  }

  .question--open {
    border-top: 2px solid var(--rule);
    border-bottom: 2px solid var(--rule);
  }

  .question--open .question-number {
    color: var(--ink);
  }

  .question-answers-here {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    margin: 1rem 0 0;
  }

  /* `.question-act` went with the link it dressed (2026-08-27). Its weight was
     not deleted with it: the accent-coloured mono is now the paste block's
     summary in src/components/PasteBlock.astro, which is the act on this page
     from here on. Left as a note rather than silently, so the next person to
     want a call to action in the open column knows one used to be here and
     where it went. */

  /*
    THE SPACE BELOW THE PAIR LIVES ON THE PAIR. The columns give up their own
    bottom margin so the two sit as one block, and the answers list that follows
    is now the component's own <section> rather than a wrapper this page owned —
    so the gap is set here, above, instead of on a block that no longer exists.
    Without it the answers heading crowds the open question's rule and reads as
    part of that column.
  */
  .question-columns--pair {
    margin-bottom: 2.6rem;
  }

  .question-number {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 0.9rem;
  }

  .question-text {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.25;
    max-width: 34rem;
    margin: 0 auto;
  }

  .question-unasked {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.25;
    color: var(--ink-soft);
    margin: 0;
  }

  /* `.lede` went with the sentence it sized (2026-08-04). Left as a note rather
     than silently: it was the last thing between the heading and the question,
     and the next person to want a line there should have to decide to add one. */

  /* The motto, in the display face it had as a heading but at prose scale —
     recognisably the line it was, sized as the first line of a block rather
     than as a title. */
  .motto {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  /* Reads as apparatus, not as a second headline: a reader who has come for the
     question above should meet this as a note under it. It sits between the
     heading and the question, which is the only place it is useful — after the
     question it would be a footnote to something the reader has already
     decided about. (It sat under the lede until 2026-08-04; the lede went and
     it did not move.) */
  .also-open {
    max-width: 34rem;
    margin: 0 auto 1.6rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--hairline);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  /* The column the apparatus reads in. The question above it is centred display
     type; the full text and the answers are prose, and prose set centred is a
     wall rather than something anybody reads. */
  .question-apparatus {
    max-width: 34rem;
    margin: 0 auto;
    text-align: left;
  }

  .question-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 30rem;
    margin: 1rem auto 0;
  }

  /* "Closed." is a STATE, not a note, so it is set like the number above the
     question rather than like the prose below it — the same mono small caps, so
     the two read as one apparatus bracketing the question. Kept short and quiet
     deliberately: it exists to stop a reader answering a shut question, which
     one word does, and anything longer would reintroduce the height the walk
     just removed. */
  .question-note--closed {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: 0.9rem;
  }

  .question-empty {
    text-align: center;
    font-style: italic;
    color: var(--ink-soft);
    padding: 2rem 0;
    border-top: 1px solid var(--hairline);
  }





  .ruling-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
